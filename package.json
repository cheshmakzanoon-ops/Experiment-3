{
  "name": "apex-formula-laboratory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original instrumented Formula racing simulation in TypeScript and Three.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:physics": "node --experimental-transform-types scripts/validate.ts && npm run test:dynamics && npm run test:race-control && npm run test:wet-pits",
    "test:endurance": "node --experimental-transform-types scripts/endurance.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src tests e2e scripts",
    "format": "prettier --write src tests e2e scripts *.json *.ts *.html",
    "check": "npm run lint && npm test && npm run build",
    "test:dynamics": "node --experimental-transform-types scripts/dynamics-benchmark.ts",
    "test:race-control": "node --experimental-transform-types scripts/marshal-integration.ts",
    "test:performance": "node --experimental-transform-types scripts/performance-compare.ts",
    "test:weather": "node --experimental-transform-types scripts/weather-selftest.ts",
    "test:wet-pits": "node --experimental-transform-types scripts/wet-pit-integration.ts"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/three": "0.180.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
