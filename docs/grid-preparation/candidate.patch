+.grid-presentation p {
+  margin: 6px 0;
+  max-width: 620px;
+}
+.grid-presentation-footer {
+  max-width: 760px;
+  pointer-events: auto;
+}
+.grid-timeline {
+  display: block;
+  margin: 14px 0;
