+#!/bin/bash
+# usage: runafter.sh <tag> <shots> [venues=mx,sx]
+# One lock hold: capture build of the worktree, a shader-compile check (abort on errors), then the
+# gameplay captures. Kills only its own processes.
+T=$1; SH=$2; V=${3:-mx,sx}; Q=${QUALITY:-high}
+W=/home/user/Experiment-3/.claude/worktrees/agent-a86a2314095fca118
+S=/tmp/claude-0/-home-user-Experiment-3/77bc90d5-fa90-573c-91d6-9e500a2bf2c9/scratchpad
+export MXPORT=5193
+flock $S/heavy.lock bash -c "
+  cd $W
+  mkdir -p test-results/mx-capture
+  cp $S/mx2/capture.mjs test-results/mx-capture/capture.mjs
+  bash $S/mx2/capbuild.sh $T WORKTREE > $S/mx2/build-$T.log 2>&1 || { echo build failed; tail -20 $S/mx2/build-$T.log; exit 1; }
+  node test-results/mx-shader-check/check.mjs chk-$T '[[\"terrain\",{\"preset\":\"high\",\"view\":\"rut\",\"sunElev\":16},\"high\"],[\"terrain\",{\"preset\":\"medium\",\"view\":\"rut\",\"sunElev\":16},\"medium\"],[\"stadium\",{\"preset\":\"high\"},\"stadium\"],[\"chase\",{\"preset\":\"high\",\"station\":170,\"sunElev\":32},\"chase\"]]' > $S/mx2/check-chk-$T.log 2>&1
+  if grep -q 'errors: [^n]' $S/mx2/check-chk-$T.log; then echo 'shader errors, aborting'; cat $S/mx2/check-chk-$T.log | head -30; exit 1; fi
+  node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port $MXPORT --strictPort --outDir $S/mx2/dist-$T > $S/mx2/preview-$T.log 2>&1 &
+  VP=\$!
+  sleep 6
+  for venue in ${V//,/ }; do
+    if [ \$venue = mx ]; then C=valley-ridge-mx; else C=arena-nord-sx; fi
+    setsid node test-results/mx-capture/capture.mjs \$C $Q $T 0 $SH > $S/mx2/cap-$T-\$C-$Q.log 2>&1 &
+    CP=\$!
+    wait \$CP || true
+    kill -- -\$CP 2>/dev/null || true
+  done
+  kill \$VP 2>/dev/null || true
+"
