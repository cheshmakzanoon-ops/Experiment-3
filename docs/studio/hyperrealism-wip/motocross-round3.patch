+#!/bin/bash
+# usage: runcap.sh <tag> <circuit> <quality> <shots> <rideSeconds> [build=0|1]
+# Runs under the shared heavy lock: (optional build) + private preview server + capture.
+# Kills only its own processes (never a pattern that could match another agent's browser).
+T=$1; C=$2; Q=$3; SH=$4; R=$5; B=${6:-0}
+W=/home/user/Experiment-3/.claude/worktrees/agent-a86a2314095fca118
+S=/tmp/claude-0/-home-user-Experiment-3/77bc90d5-fa90-573c-91d6-9e500a2bf2c9/scratchpad
+export MXPORT=5193
+flock $S/heavy.lock bash -c "
+  set -e
+  if [ '$B' = 1 ]; then bash $S/mx2/capbuild.sh $T ${REV:-WORKTREE}; fi
+  cd $W
+  mkdir -p test-results/mx-capture
+  cp $S/mx2/capture.mjs test-results/mx-capture/capture.mjs
