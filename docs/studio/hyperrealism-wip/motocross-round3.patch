+#!/usr/bin/env python3
+"""cmp.py out.png labelA a.png labelB b.png [labelC c.png ...] : stack images vertically with labels."""
+import sys
+from PIL import Image, ImageDraw
+out = sys.argv[1]
+pairs = [(sys.argv[i], sys.argv[i + 1]) for i in range(2, len(sys.argv), 2)]
+imgs = [(l, Image.open(p).convert('RGB')) for l, p in pairs]
+w = max(i.width for _, i in imgs)
+h = sum(i.height for _, i in imgs)
+canvas = Image.new('RGB', (w, h))
+y = 0
+for label, im in imgs:
+    canvas.paste(im, (0, y))
+    d = ImageDraw.Draw(canvas)
+    d.rectangle([0, y, 8 * len(label) + 12, y + 18], fill=(0, 0, 0))
+    d.text((6, y + 3), label, fill=(255, 255, 255))
+    y += im.height
+canvas.save(out)
+print(out, canvas.size)
