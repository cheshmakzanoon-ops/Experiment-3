diff --git a/src/rendering/open-world/roadside-furniture.ts b/src/rendering/open-world/roadside-furniture.ts
new file mode 100644
index 0000000..9304083
--- /dev/null
+++ b/src/rendering/open-world/roadside-furniture.ts
@@ -0,0 +1,175 @@
+import { hash01 } from '../../simulation/open-world/noise.ts';
+import { StructureGrid, type Structure } from '../../simulation/open-world/placement.ts';
+import { carvedGroundHeight } from '../../simulation/open-world/ground-height.ts';
+import { ROAD_FLAG, type RoadEdge } from '../../simulation/open-world/road-network.ts';
+import type { OpenWorld } from '../../simulation/open-world/world.ts';
+import { trackPoint } from '../../simulation/track.ts';
+
+/**
+ * Rural roadside furniture: reflective guide posts along the open roads and
+ * wooden utility poles carrying sagging three-wire spans along some of them.
+ * They give a long drive its scale, rhythm and speed cues (the posts tick
+ * past at a steady pitch, the wires rise and fall between poles). Original,
+ * deterministic plan from the road network; heights come from the carved
+ * ground the physics uses. Posts stand on the shoulder edge, poles well
+ * outside the barrier line, both clear of structures, towns and bridges.
+ */
+export const ROADSIDE_FURNITURE = Object.freeze({
+  /** Guide posts: pitch (m) per road class, offset beyond the shoulder (m). */
+  postPitch: Object.freeze({ highway: 40, country: 50, mountain: 25 }) as Readonly<
+    Record<string, number>
+  >,
+  postOffset: 0.55,
+  postHeight: 0.98,
+  /** Utility poles: span (m), height (m), offset beyond the shoulder (m),
+   * share of eligible roads that carry a line, and the wire sag (share of span). */
+  poleSpan: 52,
+  poleHeight: 9.2,
+  poleOffset: 6.5,
+  lineShare: 0.55,
+  sag: 0.011,
+  /** Crossarm half-length (m): wires hang this far to each side of the pole. */
+  armHalf: 0.85,
+});
+
+export interface RoadsidePost {
+  x: number;
+  y: number;
+  z: number;
+  /** Road heading (rad): the post's wide face looks along the road. */
+  yaw: number;
+  /** +1 on the left of travel (positive lateral), -1 on the right. */
+  side: -1 | 1;
+}
+export interface RoadsidePole {
+  x: number;
+  y: number;
+  z: number;
+  /** Road heading (rad). */
+  yaw: number;
+  /** Unit across-road axis (the crossarm lies along it). */
+  ax: number;
+  az: number;
+}
+export interface RoadsideWire {
+  from: readonly [number, number, number];
+  to: readonly [number, number, number];
+  /** Sag at the span's midpoint (m). */
+  sag: number;
+}
+export interface RoadsidePlan {
+  posts: RoadsidePost[];
+  poles: RoadsidePole[];
+  wires: RoadsideWire[];
+}
+
+/** Roads that carry furniture: public paved roads outside the towns. */
+export function furnishedEdge(edge: RoadEdge) {
+  return (
+    edge.roadClass === 'highway' || edge.roadClass === 'country' || edge.roadClass === 'mountain'
+  );
+}
+
+export function roadsidePlan(
+  world: OpenWorld,
+  structures: readonly Structure[],
+  roads: readonly RoadEdge[] = world.network.edges,
+): RoadsidePlan {
+  const net = world.network,
+    field = world.field,
+    blocked = new StructureGrid(structures),
+    p = trackPoint(),
+    q = trackPoint(),
+    plan: RoadsidePlan = { posts: [], poles: [], wires: [] };
+  const F = ROADSIDE_FURNITURE;
+  const ground = (x: number, z: number) => carvedGroundHeight(world.carver, x, z);
+  /** Is (x, z) a place furniture may stand: clear of town ground, structures,
+   * the water's edge and the carriageway of any other road. */
+  const free = (x: number, z: number, own: RoadEdge, margin: number) => {
+    if (blocked.blocks(x, z, margin) || field.flatWeight('town', x, z) > 0.3) return false;
+    if (field.height(x, z) < field.region.seaLevel + 1.5) return false;
+    // Another road (a junction or a parallel leg) must stay clear too.
+    const lateral = Math.abs(net.nearest(x, z, q)),
+      near = net.edges[net.edgeOf[net.lastSegment]];
+    return near === own
+      ? true
+      : lateral > near.spec.halfWidth + near.spec.shoulder + margin + 1;
+  };
+  for (const edge of roads) {
+    if (!furnishedEdge(edge)) continue;
+    const reach = edge.spec.halfWidth + edge.spec.shoulder;
+    const pitch = F.postPitch[edge.roadClass] ?? 50;
+    // Guide posts on both sides, staggered between sides by half a pitch.
+    for (const side of [-1, 1] as const) {
+      const start = 24 + (side > 0 ? pitch / 2 : 0);
+      for (let s = start; s < edge.length - 24; s += pitch) {
+        net.at(edge.offset + s, p);
+        net.nearest(p.x, p.z, q, p.y);
+        const flags = net.flags[net.lastSegment];
+        if (flags & (ROAD_FLAG.BRIDGE | ROAD_FLAG.JUNCTION)) continue;
+        // Guardrail on this side: the rail is the delineation.
+        if (flags & (side > 0 ? ROAD_FLAG.BARRIER_RIGHT : ROAD_FLAG.BARRIER_LEFT)) continue;
+        const lateral = side * (reach + F.postOffset),
+          x = p.x + p.nx * lateral,
+          z = p.z + p.nz * lateral;
+        if (!free(x, z, edge, 0.4)) continue;
+        plan.posts.push({
+          x,
+          y: ground(x, z),
+          z,
+          yaw: Math.atan2(p.tx, p.tz),
+          side,
+        });
+      }
+    }
+    // Utility poles on one side of selected roads.
+    if (edge.roadClass === 'mountain' || hash01(edge.index, 5, 0x2b71) >= F.lineShare) continue;
+    const side: -1 | 1 = hash01(edge.index, 9, 0x2b71) < 0.5 ? -1 : 1,
+      offset = F.poleOffset + hash01(edge.index, 11, 0x2b71) * 1.5;
+    let previous: RoadsidePole | null = null;
+    for (let s = 30; s < edge.length - 30; s += F.poleSpan) {
+      net.at(edge.offset + s, p);
+      net.nearest(p.x, p.z, q, p.y);
+      const flags = net.flags[net.lastSegment];
+      const lateral = side * (reach + offset),
+        x = p.x + p.nx * lateral,
+        z = p.z + p.nz * lateral;
+      if (
+        flags & (ROAD_FLAG.BRIDGE | ROAD_FLAG.JUNCTION) ||
+        !free(x, z, edge, 1.4) ||
+        field.forestDensity(x, z) > 0.45 ||
+        // Steep banks beside the road: the line would run through the hill.
+        Math.abs(ground(x, z) - p.y) > 6
+      ) {
+        previous = null;
+        continue;
+      }
+      const pole: RoadsidePole = {
+        x,
+        y: ground(x, z),
+        z,
+        yaw: Math.atan2(p.tx, p.tz),
+        ax: p.nx,
+        az: p.nz,
+      };
+      plan.poles.push(pole);
+      if (previous) {
+        const span = Math.hypot(pole.x - previous.x, pole.z - previous.z);
+        // Three wires: one on each arm tip and one at the pole's top.
+        for (const lane of [-1, 0, 1] as const) {
+          const reachAt = (pl: RoadsidePole) => {
+            const along = lane * F.armHalf;
+            return [
+              pl.x + pl.ax * along,
+              pl.y + F.poleHeight - (lane === 0 ? -0.35 : 0.1),
+              pl.z + pl.az * along,
+            ] as const;
+          };
+          plan.wires.push({ from: reachAt(previous), to: reachAt(pole), sag: span * F.sag });
+        }
+      }
+      previous = pole;
+    }
+  }
+  return plan;
+}
diff --git a/src/rendering/open-world/sea-horizon.ts b/src/rendering/open-world/sea-horizon.ts
