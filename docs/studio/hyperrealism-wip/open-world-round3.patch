+import { describe, expect, it } from 'vitest';
+import { morphTargetHeights } from '../src/rendering/open-world/terrain-morph.ts';
+import { buildTileData } from '../src/rendering/open-world/tile-data.ts';
+import { StructureGrid, regionStructures } from '../src/simulation/open-world/placement.ts';
+import { gridHeight, TILE_SIZE } from '../src/simulation/open-world/terrain-tiles.ts';
+import { openWorld } from '../src/simulation/open-world/world.ts';
+
+describe('Terrain geomorph targets', () => {
+  it('reproduces a planar coarse surface exactly at every child vertex', () => {
+    const cells = 4,
+      res = 8,
+      parent = new Float32Array((cells + 1) ** 2);
+    for (let j = 0; j <= cells; j++)
+      for (let i = 0; i <= cells; i++) parent[j * (cells + 1) + i] = 3 + 0.5 * i - 0.25 * j;
+    const out = morphTargetHeights(parent, cells, res);
+    for (let j = 0; j <= res; j++)
+      for (let i = 0; i <= res; i++)
+        expect(out[j * (res + 1) + i]).toBeCloseTo(3 + 0.5 * (i / 2) - 0.25 * (j / 2), 5);
+  });
+
+  it('keeps the coarse lattice vertices and splits each coarse quad along the render diagonal', () => {
+    const cells = 2,
+      res = 8,
+      parent = Float32Array.from([0, 4, 0, 0, 0, 8, 12, 0, 0]);
+    const out = morphTargetHeights(parent, cells, res),
+      k = res / cells;
+    for (let j = 0; j <= cells; j++)
+      for (let i = 0; i <= cells; i++)
+        expect(out[j * k * (res + 1) + i * k]).toBe(parent[j * (cells + 1) + i]);
+    for (let j = 0; j <= res; j++)
+      for (let i = 0; i <= res; i++)
+        expect(out[j * (res + 1) + i]).toBeCloseTo(
+          gridHeight(parent, cells + 1, i / k, j / k, 1),
+          6,
+        );
+    // The diagonal a-d is shared: a point on it is the mean of the two corners.
+    const quad = Float32Array.from([2, 9, 5, 7, 11, 13, 17, 19, 23]);
+    const mid = morphTargetHeights(quad, 2, 4);
+    // child vertex (1, 1) is halfway along the a-d diagonal of coarse quad (0, 0)
+    expect(mid[1 * 5 + 1]).toBeCloseTo((quad[0] + quad[4]) / 2, 6);
+  });
+
+  it('rejects a lattice that does not tile the child grid', () => {
+    expect(() => morphTargetHeights(new Float32Array(9), 2, 5)).toThrow(RangeError);
+    expect(() => morphTargetHeights(new Float32Array(8), 2, 4)).toThrow(RangeError);
+  });
+});
+
+describe('Tile worker morph lattice', () => {
+  const world = openWorld(),
+    structures = new StructureGrid(regionStructures(world));
+  const base = { type: 'tile' as const, trees: 0 };
+
+  // The parent lattice a child tile carries must be the very surface its parent
+  // tile draws there, for the same-resolution (64 -> 64) and the 64 -> 32 hand-overs.
+  it.each([
+    { name: 'level 0 -> 1', size: TILE_SIZE, res: 64, parentRes: 64 },
+    { name: 'level 2 -> 3', size: TILE_SIZE * 4, res: 64, parentRes: 32 },
+    { name: 'level 3 -> 4', size: TILE_SIZE * 8, res: 32, parentRes: 32 },
+  ])('$name: child parentHeights equal the parent tile heights', ({ size, res, parentRes }) => {
+    const x0 = -2048, // an arbitrary tile-aligned origin
+      z0 = -2560;
+    const aligned = (v: number) => Math.floor(v / (size * 2)) * size * 2;
+    const px0 = aligned(x0),
+      pz0 = aligned(z0),
+      // child = the quadrant of the parent tile containing (x0, z0)
+      cx0 = px0 + (x0 - px0 >= size ? size : 0),
+      cz0 = pz0 + (z0 - pz0 >= size ? size : 0);
+    const cells = parentRes / 2;
+    const child = buildTileData(world, structures, {
+      ...base,
+      id: 1,
+      x0: cx0,
+      z0: cz0,
+      size,
+      res,
+      parentCells: cells,
+    });
+    const parent = buildTileData(world, structures, {
+      ...base,
+      id: 2,
+      x0: px0,
+      z0: pz0,
+      size: size * 2,
+      res: parentRes,
+    });
+    expect(child.parentHeights?.length).toBe((cells + 1) ** 2);
+    const offI = Math.round((cx0 - px0) / ((size * 2) / parentRes)),
+      offJ = Math.round((cz0 - pz0) / ((size * 2) / parentRes));
+    for (let j = 0; j <= cells; j++)
+      for (let i = 0; i <= cells; i++)
+        expect(child.parentHeights![j * (cells + 1) + i]).toBeCloseTo(
+          parent.heights[(offJ + j) * (parentRes + 1) + offI + i],
+          3,
+        );
+  });
+
+  it('carries no lattice for a tile without a coarser level', () => {
+    const top = buildTileData(world, structures, {
+      ...base,
+      id: 3,
+      x0: -2048,
+      z0: -2560,
+      size: TILE_SIZE,
+      res: 64,
+    });
+    expect(top.parentHeights).toBeUndefined();
+  });
+});
diff --git a/tests/festival-terrain-streamer-morph.test.ts b/tests/festival-terrain-streamer-morph.test.ts
new file mode 100644
index 0000000..824ea0d
--- /dev/null
+++ b/tests/festival-terrain-streamer-morph.test.ts
@@ -0,0 +1,160 @@
+import * as T from 'three';
+import { describe, expect, it } from 'vitest';
+import {
+  TERRAIN_EXTENT,
+  TERRAIN_LEVELS,
+  TERRAIN_BUDGETS,
+  TerrainStreamer,
+  groundSample,
+} from '../src/rendering/open-world/terrain.ts';
+import { TILE_SIZE } from '../src/simulation/open-world/terrain-tiles.ts';
+import type { TileMeshData, TileRequest } from '../src/workers/open-world-protocol.ts';
+
+/** A worker that answers every tile request with a synthetic surface:
+ * height h(x, z) at the lattice of the requested level, and a coarser lattice
+ * (`parentCells`) of the same smooth field plus a level-dependent offset, so
+ * parent and child surfaces are distinguishable. */
+class FakeWorker {
+  listeners: ((event: MessageEvent) => void)[] = [];
+  requests: TileRequest[] = [];
+  addEventListener(_: string, fn: (event: MessageEvent) => void) {
+    this.listeners.push(fn);
+  }
+  removeEventListener() {}
+  postMessage(request: TileRequest) {
+    this.requests.push(request);
+  }
+  /** Reply to everything requested so far. */
+  flush() {
+    const batch = this.requests.splice(0);
+    for (const req of batch) {
+      const side = req.res + 1,
+        step = req.size / req.res,
+        height = (x: number, z: number, lod = 0) => 40 + 0.02 * x + 0.01 * z + lod * 3;
+      const heights = new Float32Array(side * side);
+      for (let j = 0; j < side; j++)
+        for (let i = 0; i < side; i++) heights[j * side + i] = height(req.x0 + i * step, req.z0 + j * step);
+      let parentHeights: Float32Array | undefined;
+      if (req.parentCells) {
+        const cells = req.parentCells,
+          pstep = req.size / cells;
+        parentHeights = new Float32Array((cells + 1) ** 2);
+        for (let j = 0; j <= cells; j++)
+          for (let i = 0; i <= cells; i++)
+            parentHeights[j * (cells + 1) + i] = height(req.x0 + i * pstep, req.z0 + j * pstep, 1);
+      }
+      const normals = new Float32Array(side * side * 3);
+      for (let v = 0; v < side * side; v++) normals[v * 3 + 1] = 1;
+      const splat = new Float32Array(side * side * 4),
+        shade = new Float32Array(side * side * 4);
+      for (let v = 0; v < side * side; v++) {
+        splat[v * 4 + 2] = 0.25; // sand
+        shade[v * 4] = 0.5; // road influence
+        shade[v * 4 + 1] = 0.75; // forest
+      }
+      const data: TileMeshData = {
+        type: 'tile',
+        id: req.id,
+        heights,
+        normals,
+        splat,
+        shade,
+        trees: new Float32Array(0),
+        parentHeights,
+        minY: Math.min(...heights),
+        maxY: Math.max(...heights),
+        ms: 1,
+      };
+      for (const fn of this.listeners) fn({ data } as MessageEvent);
+    }
+    return batch.length;
+  }
+}
+
+function settle(streamer: TerrainStreamer, worker: FakeWorker, camera: T.Camera, rounds = 14) {
+  for (let i = 0; i < rounds; i++) {
+    streamer.update(camera);
+    if (!worker.flush()) break;
+  }
+  streamer.update(camera);
+}
+
+describe('Terrain streamer geomorph attributes and ground sampling', () => {
+  const origin = -TERRAIN_EXTENT / 2;
+  // The centre of a finest-level tile, 20 m above its surface.
+  const cx = origin + 40 * TILE_SIZE + TILE_SIZE / 2,
+    cz = origin + 35 * TILE_SIZE + TILE_SIZE / 2;
+  const camera = new T.PerspectiveCamera();
+  camera.position.set(cx, 80, cz);
+  camera.updateMatrixWorld();
+
+  it('asks every level except the top one for its parent lattice', () => {
+    const worker = new FakeWorker(),
+      streamer = new TerrainStreamer(worker as unknown as Worker, TERRAIN_BUDGETS.high);
+    streamer.update(camera);
+    const requested = new Map(worker.requests.map((r) => [Math.round(Math.log2(r.size / TILE_SIZE)), r]));
+    expect(requested.get(TERRAIN_LEVELS)?.parentCells ?? 0).toBe(0);
+    worker.flush();
+    for (let i = 0; i < 12; i++) {
+      streamer.update(camera);
+      for (const r of worker.requests) requested.set(Math.round(Math.log2(r.size / TILE_SIZE)), r);
+      worker.flush();
+    }
+    // 64 -> 64: 32 cells; level 2 (64 cells) under level 3 (32 cells): 16; 32 -> 32: 16.
+    expect(requested.get(0)?.parentCells).toBe(32);
+    expect(requested.get(1)?.parentCells).toBe(32);
+    expect(requested.get(2)?.parentCells).toBe(16);
+    expect(requested.get(3)?.parentCells).toBe(16);
+  });
+
+  it('builds the morph attribute: parent surface height, parent tile edge, dropped skirt twins', () => {
+    const worker = new FakeWorker(),
+      streamer = new TerrainStreamer(worker as unknown as Worker, TERRAIN_BUDGETS.high);
+    settle(streamer, worker, camera);
+    const tiles = streamer.root.children.filter((c): c is T.Mesh => c instanceof T.Mesh);
