@@ -0,0 +1,48 @@
+import { injectAfter, injectBefore, injectDeclarations } from '../studio/shader-hooks.ts';
+
+/** 1 keeps the sea's reflections above the horizon (see below); a debug and
+ * A/B switch, on for every preset. */
+export const seaHorizon = { value: 1 };
+/** A wave facet tilted away from the viewer can turn a grazing view's mirror
+ * ray below the horizon, where a flat cube probe holds the *land* around
+ * the car (tan, grassy) and paints it into the sea as pale patches with dark
+ * rims. A real sea would show other waves there, i.e. dark water, and the
+ * horizon's sky is the closest honest value: the ray is bent back above the
+ * horizon by tilting the facet normal toward the sky, for the environment
+ * lookup only. Shared by the open sea and the shore water. */
+export function installSeaHorizonClamp(shader: Parameters<typeof injectAfter>[0]) {
+  shader.uniforms.owSeaHorizon = seaHorizon;
+  injectDeclarations(shader, 'common', 'uniform float owSeaHorizon;', 'fragment');
+  injectBefore(
+    shader,
+    'lights_fragment_maps',
+    /* glsl */ `
+vec3 owSeaSaveN = geometryNormal;
+#ifdef USE_CLEARCOAT
+vec3 owSeaSaveCN = geometryClearcoatNormal;
+#endif
+if (owSeaHorizon > 0.5) {
+  vec3 owSeaUp = normalize((viewMatrix * vec4(0.0, 1.0, 0.0, 0.0)).xyz);
+  vec3 owSeaN = geometryNormal;
+  for (int i = 0; i < 3; i++) {
+    if (dot(reflect(-geometryViewDir, owSeaN), owSeaUp) >= 0.05) break;
+    owSeaN = normalize(mix(owSeaN, owSeaUp, 0.4));
+  }
+  geometryNormal = owSeaN;
+#ifdef USE_CLEARCOAT
+  geometryClearcoatNormal = owSeaN;
+#endif
+}`,
+    'fragment',
+  );
+  injectAfter(
+    shader,
+    'lights_fragment_maps',
+    /* glsl */ `
+geometryNormal = owSeaSaveN;
+#ifdef USE_CLEARCOAT
+geometryClearcoatNormal = owSeaSaveCN;
+#endif`,
+    'fragment',
+  );
+}
