+import * as T from 'three';
+import { describe, expect, it } from 'vitest';
+import { installSeaHorizonClamp, seaHorizon } from '../src/rendering/open-world/sea-horizon.ts';
+import type { StudioShader } from '../src/rendering/studio/shader-hooks.ts';
+
+function physicalShader() {
+  return {
+    vertexShader: T.ShaderLib.physical.vertexShader,
+    fragmentShader: T.ShaderLib.physical.fragmentShader,
+    uniforms: T.UniformsUtils.clone(T.ShaderLib.physical.uniforms),
+  } as StudioShader;
+}
+
+describe('Sea horizon clamp', () => {
+  it('brackets the environment lookup: tilt before, restore after, one uniform', () => {
+    const shader = physicalShader();
+    installSeaHorizonClamp(shader);
+    const f = shader.fragmentShader,
+      before = f.indexOf('owSeaSaveN = geometryNormal'),
+      anchor = f.indexOf('#include <lights_fragment_maps>'),
+      restore = f.indexOf('geometryNormal = owSeaSaveN');
+    expect(before).toBeGreaterThan(0);
+    expect(anchor).toBeGreaterThan(before);
+    expect(restore).toBeGreaterThan(anchor);
+    // The save sits after the geometry exists (lights_fragment_begin) and the
+    // restore before the end of the light loop's consumers.
+    expect(f.indexOf('#include <lights_fragment_begin>')).toBeLessThan(before);
+    expect(f.indexOf('#include <lights_fragment_end>')).toBeGreaterThan(restore);
+    expect(shader.uniforms.owSeaHorizon).toBe(seaHorizon);
+    expect(seaHorizon.value).toBe(1);
+    expect(f.match(/uniform float owSeaHorizon;/g)).toHaveLength(1);
+  });
+
+  it('only touches the clearcoat normal when the material has a clearcoat', () => {
+    const shader = physicalShader();
+    installSeaHorizonClamp(shader);
+    const lines = shader.fragmentShader.split('\n');
+    lines.forEach((line, i) => {
+      if (line.includes('geometryClearcoatNormal = owSea') || line.includes('owSeaSaveCN')) {
+        // Every such line is inside an #ifdef USE_CLEARCOAT region.
+        const above = lines.slice(Math.max(0, i - 3), i).join('\n');
+        expect(above + line).toMatch(/#ifdef USE_CLEARCOAT|geometryClearcoatNormal = owSea/);
+      }
+    });
+    expect(shader.fragmentShader).toContain('#ifdef USE_CLEARCOAT\nvec3 owSeaSaveCN = geometryClearcoatNormal;\n#endif');
+  });
+});
