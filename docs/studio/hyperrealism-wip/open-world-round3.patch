+/** CPU twin of OW_NOISE_GLSL (terrain-material.ts): the same hash, value noise
+ * and fbm, so placement code can read the terrain shader's own world-space
+ * fields (macro dryness, sward patches) and agree with the ground it sits on. */
+const fract = (x: number) => x - Math.floor(x);
+
+export function owHash(x: number, y: number): number {
+  let a = fract(x * 0.1031),
+    b = fract(y * 0.1031),
+    c = a;
+  const d = a * (b + 33.33) + b * (c + 33.33) + c * (a + 33.33);
+  a += d;
+  b += d;
+  c += d;
+  return fract((a + b) * c);
+}
+
+export function owNoise(x: number, y: number): number {
+  const ix = Math.floor(x),
+    iy = Math.floor(y),
+    fx = x - ix,
+    fy = y - iy,
+    ux = fx * fx * (3 - 2 * fx),
+    uy = fy * fy * (3 - 2 * fy),
+    a = owHash(ix, iy),
+    b = owHash(ix + 1, iy),
+    c = owHash(ix, iy + 1),
+    d = owHash(ix + 1, iy + 1);
+  return a + (b - a) * ux + (c + (d - c) * ux - (a + (b - a) * ux)) * uy;
+}
+
+/** `detail` in 0..1 scales the two upper octaves, as in the shader. */
+export function owFbm(x: number, y: number, detail = 1): number {
+  const s =
+    owNoise(x, y) * 0.5 +
+    owNoise(x * 2.07 + 17.1, y * 2.07 + 17.1) * 0.25 * detail +
+    owNoise(x * 4.13 - 9.7, y * 4.13 - 9.7) * 0.125 * detail;
+  return s / (0.5 + 0.375 * detail);
+}
+
+export const smooth01 = (a: number, b: number, x: number) => {
+  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
+  return t * t * (3 - 2 * t);
+};
