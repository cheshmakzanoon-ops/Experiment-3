diff --git a/tests/festival-grass-field.test.ts b/tests/festival-grass-field.test.ts
new file mode 100644
index 0000000..c2f2e77
--- /dev/null
+++ b/tests/festival-grass-field.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from 'vitest';
+import {
+  GRASS_FIELD,
+  dryShare,
+  grassCover,
+  grassFieldCell,
+  type GrassSampler,
+} from '../src/rendering/open-world/grass-field.ts';
+import { groundSample, type GroundSample } from '../src/rendering/open-world/terrain.ts';
+import { owFbm, owHash, owNoise } from '../src/rendering/open-world/ow-noise.ts';
+
+const meadow = (over: Partial<GroundSample> = {}): GroundSample => ({ ...groundSample(), ...over });
+const sampler = (
+  ground: (x: number, z: number) => Partial<GroundSample> | null,
+  allowed: GrassSampler['allowed'] = () => true,
+): GrassSampler => ({
+  ground: (x, z, out) => {
+    const g = ground(x, z);
+    if (!g) return false;
+    Object.assign(out, groundSample(), { y: 10 + x * 0.01 }, g);
+    return true;
+  },
+  allowed,
+});
+const TILES = 8;
+
+describe('Near-field meadow planting', () => {
+  it('is deterministic and keeps every clump inside its cell', () => {
+    const a = grassFieldCell(3, -7, 1.2, TILES, sampler(() => ({}))),
+      b = grassFieldCell(3, -7, 1.2, TILES, sampler(() => ({})));
+    expect(a).toEqual(b);
+    expect(a!.length).toBeGreaterThan(200);
+    const size = GRASS_FIELD.cell;
+    for (const c of a!) {
+      expect(c.x).toBeGreaterThanOrEqual(3 * size);
+      expect(c.x).toBeLessThan(4 * size + 1e-6);
+      expect(c.z).toBeGreaterThanOrEqual(-7 * size);
+      expect(c.z).toBeLessThan(-6 * size + 1e-6);
+      expect(c.tile).toBeGreaterThanOrEqual(0);
+      expect(c.tile).toBeLessThan(TILES);
+      expect(c.width).toBeGreaterThan(0.45);
+    }
+  });
+
+  it('plants more densely where the density setting is higher', () => {
+    const lo = grassFieldCell(0, 0, 0.8, TILES, sampler(() => ({})))!.length,
+      hi = grassFieldCell(0, 0, 1.45, TILES, sampler(() => ({})))!.length;
+    expect(hi).toBeGreaterThan(lo * 1.4);
+  });
+
+  it('leaves bare ground, steep faces and refused spots empty', () => {
+    expect(grassFieldCell(0, 0, 1, TILES, sampler(() => ({ sand: 1 })))).toHaveLength(0);
+    expect(grassFieldCell(0, 0, 1, TILES, sampler(() => ({ rock: 1 })))).toHaveLength(0);
+    expect(grassFieldCell(0, 0, 1, TILES, sampler(() => ({ ny: 0.6 })))).toHaveLength(0);
+    expect(
+      grassFieldCell(
+        0,
+        0,
+        1,
+        TILES,
+        sampler(
+          () => ({}),
+          () => false,
+        ),
+      ),
+    ).toHaveLength(0);
+    // Half the cell is road: nothing roots in that half.
+    const half = grassFieldCell(
+      0,
+      0,
+      1,
+      TILES,
+      sampler(
+        () => ({}),
+        (x) => x > GRASS_FIELD.cell / 2,
+      ),
+    )!;
+    expect(half.length).toBeGreaterThan(50);
+    expect(half.every((c) => c.x > GRASS_FIELD.cell / 2)).toBe(true);
+  });
+
+  it('defers the whole cell while any ground under it is still streaming', () => {
+    const size = GRASS_FIELD.cell;
+    expect(grassFieldCell(0, 0, 1, TILES, sampler((x) => (x > size * 0.9 ? null : {})))).toBeNull();
+  });
+
+  it('roots each clump on the sampled ground', () => {
+    for (const c of grassFieldCell(2, 2, 1, TILES, sampler(() => ({})))!)
+      expect(c.y).toBeCloseTo(10 + c.x * 0.01 - 0.04, 6);
+  });
+
+  it('picks late-summer tiles where the terrain shader is dry and green tiles where it is lush', () => {
+    // Find a dry and a lush neighbourhood from the shared field.
+    let dry = 0,
+      lush = 0;
+    for (let x = 0; x < 20000; x += 700) {
+      const s = dryShare(x, 123);
+      if (s > dry) dry = s;
+      if (s < 0.01) lush++;
+    }
+    expect(dry).toBeGreaterThan(0.5);
+    expect(lush).toBeGreaterThan(0);
+  });
+
+  it('measures grass cover from the terrain layers', () => {
+    expect(grassCover(meadow())).toBe(1);
+    expect(grassCover(meadow({ sand: 1 }))).toBe(0);
+    expect(grassCover(meadow({ rock: 0.5 }))).toBeLessThan(0.5);
+    expect(grassCover(meadow({ forest: 1 }))).toBeCloseTo(0.45, 6);
+  });
+});
+
+describe('Shader noise twin', () => {
+  it('stays in range and is continuous', () => {
+    for (let i = 0; i < 500; i++) {
+      const x = (i * 7.31) % 211,
+        y = (i * 3.77) % 197;
+      expect(owHash(x, y)).toBeGreaterThanOrEqual(0);
+      expect(owHash(x, y)).toBeLessThan(1);
+      expect(Math.abs(owNoise(x, y) - owNoise(x + 1e-4, y))).toBeLessThan(1e-3);
+      const f = owFbm(x, y);
+      expect(f).toBeGreaterThanOrEqual(0);
+      expect(f).toBeLessThanOrEqual(1);
+    }
+  });
+});
