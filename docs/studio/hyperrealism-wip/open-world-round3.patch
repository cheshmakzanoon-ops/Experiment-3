+import { describe, expect, it } from 'vitest';
+import {
+  ROADSIDE_FURNITURE,
+  furnishedEdge,
+  roadsidePlan,
+} from '../src/rendering/open-world/roadside-furniture.ts';
+import { regionStructures } from '../src/simulation/open-world/placement.ts';
+import { openWorld } from '../src/simulation/open-world/world.ts';
+import { trackPoint } from '../src/simulation/track.ts';
+
+const world = openWorld(),
+  structures = regionStructures(world),
+  plan = roadsidePlan(world, structures),
+  net = world.network;
+
+describe('Roadside furniture plan', () => {
+  it('is deterministic', () => {
+    const again = roadsidePlan(world, structures);
+    expect(again.posts.length).toBe(plan.posts.length);
+    expect(again.poles[again.poles.length - 1]).toEqual(plan.poles[plan.poles.length - 1]);
+    expect(again.wires[0]).toEqual(plan.wires[0]);
+  });
+
+  it('lines the public roads with posts at their pitch and carries some utility lines', () => {
+    const km = net.edges.filter(furnishedEdge).reduce((n, e) => n + e.length / 1000, 0);
+    expect(plan.posts.length).toBeGreaterThan(km * 15);
+    expect(plan.posts.length).toBeLessThan(km * 60);
+    expect(plan.poles.length).toBeGreaterThan(20);
+    // Three wires per span, one span fewer than poles per unbroken line.
+    expect(plan.wires.length % 3).toBe(0);
+    expect(plan.wires.length / 3).toBeLessThan(plan.poles.length);
+    expect(plan.wires.length).toBeGreaterThan(0);
+  });
+
+  it('keeps every post and pole off the carriageway and its shoulder', () => {
+    const q = trackPoint();
+    for (const thing of [...plan.posts.slice(0, 600), ...plan.poles]) {
+      const lateral = Math.abs(net.nearest(thing.x, thing.z, q)),
+        edge = net.edges[net.edgeOf[net.lastSegment]];
+      expect(lateral).toBeGreaterThan(edge.spec.halfWidth + edge.spec.shoulder + 0.2);
+    }
+  });
+
+  it('stands on finite ground and puts the wires above it with a real sag', () => {
+    for (const post of plan.posts) expect(Number.isFinite(post.y)).toBe(true);
+    for (const wire of plan.wires.slice(0, 300)) {
+      expect(wire.sag).toBeGreaterThan(0);
+      expect(wire.sag).toBeLessThan(2);
+      expect(Math.hypot(wire.to[0] - wire.from[0], wire.to[2] - wire.from[2])).toBeLessThan(
+        ROADSIDE_FURNITURE.poleSpan * 1.05,
+      );
+      expect(wire.from[1]).toBeGreaterThan(ROADSIDE_FURNITURE.poleHeight - 1);
+    }
+  });
+
+  it('plants nothing on towns, runways, dirt tracks or circuits', () => {
+    expect(furnishedEdge(net.edges.find((e) => e.roadClass === 'town')!)).toBe(false);
+    expect(furnishedEdge(net.edges.find((e) => e.roadClass === 'dirt')!)).toBe(false);
+    expect(furnishedEdge(net.edges.find((e) => e.roadClass === 'runway')!)).toBe(false);
+    expect(furnishedEdge(net.edges.find((e) => e.roadClass === 'circuit')!)).toBe(false);
+  });
+});
