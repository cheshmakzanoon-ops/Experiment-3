+import { gridHeight } from '../../simulation/open-world/terrain-tiles.ts';
+
+/**
+ * Geomorph targets. The next-coarser level draws this footprint as a coarse
+ * lattice (`cells` per side, its own band-limited carved heights, every quad
+ * split along the same (i, j)-(i+1, j+1) diagonal as the render mesh). This
+ * returns, for each vertex of the child's (res + 1)² grid, the height that
+ * coarse mesh has at that vertex's position. Moving a vertex to it makes the
+ * child draw exactly the parent's surface, so the hand-over between the two
+ * levels (and the seam to an unsplit neighbour of the parent's level) is
+ * free of height steps.
+ */
+export function morphTargetHeights(parent: Float32Array, cells: number, res: number): Float32Array {
+  const side = res + 1;
+  if (!(cells >= 1) || res % cells !== 0 || parent.length !== (cells + 1) * (cells + 1))
+    throw new RangeError('Morph lattice does not tile the child grid');
+  const k = res / cells,
+    out = new Float32Array(side * side);
+  for (let j = 0; j < side; j++)
+    for (let i = 0; i < side; i++) out[j * side + i] = gridHeight(parent, cells + 1, i / k, j / k, 1);
+  return out;
+}
