diff --git a/src/rendering/open-world/grass-field.ts b/src/rendering/open-world/grass-field.ts
new file mode 100644
index 0000000..2e02fdd
--- /dev/null
+++ b/src/rendering/open-world/grass-field.ts
@@ -0,0 +1,200 @@
+import * as T from 'three';
+import type { QualityPreset } from '../options.ts';
+import { GRASS, TrackGrass, type GrassClump } from '../vegetation/grass.ts';
+import type { VegetationSpecies } from '../vegetation/library.ts';
+import { VEGETATION } from '../vegetation/materials.ts';
+import { owFbm, owHash, smooth01 } from './ow-noise.ts';
+import { groundSample, type GroundSample } from './terrain.ts';
+
+/**
+ * Near-field meadow (High and ULTRA). The terrain's scanned grass carries the
+ * far field, but a lawn seen from a car is not a texture: within the grass
+ * distance of the camera every open meadow is planted with the same
+ * photographed clump cards the circuit verges use, so the ground reads as
+ * vegetation with parallax, silhouettes and self-shadowing instead of a
+ * printed surface. Cells of `cell` metres stream in around the camera (four
+ * per vegetation chunk, so each is one instanced draw), planted
+ * deterministically from the terrain's own surface weights, density patches
+ * and the shader's dryness fields; the clump material fades them into the
+ * ground at the grass distance.
+ */
+export const GRASS_FIELD = Object.freeze({
+  /** Cell edge (m); divides the vegetation chunk, so a cell is one draw. */
+  cell: GRASS.chunk / 4,
+  /** Clumps per m² on open grass (before patchiness). */
+  density: Object.freeze({ low: 0, medium: 0, high: 0.8, ultra: 1.45 }),
+  /** Cells planted per frame (the rest wait their turn). */
+  perFrame: 2,
+  /** Steepest ground (surface normal's up component) that carries grass. */
+  minUp: 0.8,
+});
+
+export interface GrassSampler {
+  /** Ground and surface weights; false while the tile is not resident. */
+  ground(x: number, z: number, out: GroundSample): boolean;
+  /** May a clump of this radius root here (not road, structure, shore)? */
+  allowed(x: number, z: number, radius: number, ground: GroundSample): boolean;
+}
+
+/** Share of a point's ground that is grass, from the terrain layer weights. */
+export function grassCover(g: GroundSample): number {
+  const bare = Math.min(
+    1,
+    g.rock * 1.15 + g.sand * 1.1 + g.snow * 1.2 + g.soil * 0.9 + g.town * 0.7,
+  );
+  // The shader fades the layers by their splat weight: grass is the remainder.
+  return Math.max(0, 1 - bare) * (1 - 0.55 * g.forest);
+}
+
+/** Share of dry (late-summer) tiles at a point: the same macro dryness and
+ * seeding patches the terrain shader paints, so tufts match the ground. */
+export function dryShare(x: number, z: number): number {
+  const macro = owFbm(x * 0.0021, z * 0.0021, 1),
+    straw = smooth01(0.6, 0.78, owFbm(x * 0.012 - 7.7, z * 0.012 + 2.9, 1));
+  return Math.min(1, smooth01(0.35, 0.75, macro) * 0.5 + straw * 0.85);
+}
+
+/** Deterministic clumps of one cell: a pure function of the cell, the
+ * sampler and the tile layout (unit-tested without a GPU). Null while any
+ * ground under the cell is not yet resident. */
+export function grassFieldCell(
+  cx: number,
+  cz: number,
+  density: number,
+  tiles: number,
+  sampler: GrassSampler,
+): GrassClump[] | null {
+  const size = GRASS_FIELD.cell,
+    n = Math.ceil(size * Math.sqrt(density)),
+    spacing = size / n,
+    green = Math.ceil(tiles / 2),
+    out: GrassClump[] = [],
+    g = groundSample();
+  const x0 = cx * size,
+    z0 = cz * size;
+  for (let j = 0; j < n; j++)
+    for (let i = 0; i < n; i++) {
+      const seed = cx * 7919 + cz * 104729 + (j * n + i) * 31;
+      const x = x0 + (i + owHash(seed, 1.7)) * spacing,
+        z = z0 + (j + owHash(seed, 4.3)) * spacing;
+      if (!sampler.ground(x, z, g)) return null;
+      // Patchy density: bald spots, thick tussock areas, a few gaps.
+      const patch = smooth01(0.22, 0.62, owFbm(x * 0.16 + 3.1, z * 0.16 - 5.7, 1)),
+        keep = grassCover(g) * (0.3 + 0.95 * patch);
+      if (g.ny < GRASS_FIELD.minUp || owHash(seed, 9.1) > keep) continue;
+      const w = 0.5 + 0.55 * owHash(seed, 6.9);
+      if (!sampler.allowed(x, z, w * 0.5, g)) continue;
+      const dry = owHash(seed, 2.9) < dryShare(x, z),
+        pick = owHash(seed, 8.3);
+      out.push({
+        x,
+        y: g.y - 0.04,
+        z,
+        width: w,
+        height: GRASS.height[0] + (GRASS.height[1] - GRASS.height[0]) * owHash(seed, 5.5),
+        yaw: owHash(seed, 3.3) * Math.PI * 2,
+        tile: dry
+          ? Math.min(tiles - 1, green + Math.floor(pick * Math.max(1, tiles - green)))
+          : Math.min(green - 1, Math.floor(pick * green)),
+        tint: owHash(seed, 7.7),
+      });
+    }
+  return out;
+}
+
+interface Cell {
+  grass: TrackGrass | null;
+  /** Frames to wait before the next attempt (tile still streaming). */
+  retry: number;
+}
+
+/** Streams the near meadow around the camera. */
+export class GrassField {
+  readonly root = new T.Group();
+  private readonly cells = new Map<string, Cell>();
+  private readonly eye = new T.Vector3();
+  private readonly tiles: number;
+  /** Switch the whole layer off (A/B captures, diagnostics). */
+  enabled = true;
+  stats = { cells: 0, clumps: 0, built: 0 };
+  constructor(
+    private readonly species: VegetationSpecies,
+    private readonly sampler: GrassSampler,
+  ) {
+    this.root.name = 'Festival near meadow';
+    this.tiles = species.grass?.tiles ?? 0;
+  }
+
+  update(camera: T.Camera, preset: QualityPreset) {
+    const density = GRASS_FIELD.density[preset],
+      reach = VEGETATION.grass[preset];
+    this.root.visible = this.enabled && density > 0 && reach > 0 && this.tiles > 0;
+    if (!this.root.visible) {
+      this.drop(() => true);
+      return;
+    }
+    camera.getWorldPosition(this.eye);
+    const size = GRASS_FIELD.cell,
+      range = Math.ceil((reach + size * 0.5) / size),
+      ccx = Math.floor(this.eye.x / size),
+      ccz = Math.floor(this.eye.z / size);
+    const wanted: { key: string; cx: number; cz: number; d: number }[] = [];
+    for (let dz = -range; dz <= range; dz++)
+      for (let dx = -range; dx <= range; dx++) {
+        const cx = ccx + dx,
+          cz = ccz + dz,
+          // Distance from the eye to the cell's nearest edge point.
+          nx = Math.max(cx * size - this.eye.x, 0, this.eye.x - (cx + 1) * size),
+          nz = Math.max(cz * size - this.eye.z, 0, this.eye.z - (cz + 1) * size),
+          d = Math.hypot(nx, nz);
+        if (d < reach) wanted.push({ key: `${cx}:${cz}`, cx, cz, d });
+      }
+    wanted.sort((a, b) => a.d - b.d);
+    let budget = GRASS_FIELD.perFrame;
+    for (const w of wanted) {
+      let cell = this.cells.get(w.key);
+      if (!cell) this.cells.set(w.key, (cell = { grass: null, retry: 0 }));
+      // A planted cell, or an empty one (retry parked high), is final.
+      if (cell.grass || budget <= 0) continue;
+      if (cell.retry > 0) {
+        cell.retry--;
+        continue;
+      }
+      const plan = grassFieldCell(w.cx, w.cz, density, this.tiles, this.sampler);
+      if (!plan) {
+        cell.retry = 20;
+        continue;
+      }
+      budget--;
+      this.stats.built++;
+      if (plan.length) {
+        cell.grass = new TrackGrass(this.species, plan);
+        this.root.add(cell.grass.root);
+      } else cell.retry = 1e9;
+    }
+    const keep = new Set(wanted.map((w) => w.key));
+    this.drop((key) => !keep.has(key));
+    let clumps = 0;
+    for (const cell of this.cells.values())
+      if (cell.grass) {
+        cell.grass.update(camera, reach);
+        clumps += cell.grass.clumps;
+      }
+    this.stats.cells = this.cells.size;
+    this.stats.clumps = clumps;
+  }
+
+  private drop(test: (key: string) => boolean) {
+    for (const [key, cell] of this.cells)
+      if (test(key)) {
+        cell.grass?.dispose();
+        this.cells.delete(key);
+      }
+  }
+
+  /** The loaded library owns the shared geometry and materials. */
+  dispose() {
+    this.drop(() => true);
+    this.root.removeFromParent();
+  }
+}
