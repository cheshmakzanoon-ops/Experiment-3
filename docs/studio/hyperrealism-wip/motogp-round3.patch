+// Usage: node ref-ab.mjs <beforeRoot|-> <afterRoot|-> <outPrefix> <views,comma> [lean] [vehicle] [flagsJson]
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+import { writeFileSync, copyFileSync, mkdirSync } from 'node:fs';
+const { chromium } = createRequire('/opt/node22/lib/node_modules/playwright/package.json')('playwright');
+const [beforeRoot, afterRoot, out, viewList, lean = '0', vehicle = 'gpr1', flagsJson = '{}'] = process.argv.slice(2);
+const SRC = '/home/user/Experiment-3/.claude/worktrees/agent-a98ba1889308b2f68/test-results/gp-capture/ref.ts';
+const views = viewList.split(',');
+const req = createRequire('/home/user/Experiment-3/package.json');
+const { build } = await import(req.resolve('vite'));
+async function bundle(root) {
+  mkdirSync(resolve(root, 'test-results/gp-capture'), { recursive: true });
+  copyFileSync(SRC, resolve(root, 'test-results/gp-capture/ref.ts'));
+  process.chdir(root);
+  const b = await build({
+    root, configFile: false, logLevel: 'error',
+    define: { __SUPPLIED_PLAYER__: 'false' },
+    build: { write: false, lib: { entry: resolve(root, 'test-results/gp-capture/ref.ts'), name: 'GpRef', formats: ['iife'] } },
+  });
+  return (Array.isArray(b) ? b[0] : b).output.find((e) => e.type === 'chunk').code;
+}
+const sides = [['before', beforeRoot], ['after', afterRoot]].filter(([, r]) => r && r !== '-');
+const browser = await chromium.launch();
+for (const [label, root] of sides) {
+  const t0 = Date.now();
+  const code = await bundle(root);
+  console.log(label, 'built', ((Date.now() - t0) / 1000).toFixed(0), 's');
+  const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
+  page.on('pageerror', (e) => console.log(label, 'pageerror', e.message));
+  page.on('console', (m) => { if (m.type() === 'error' || m.type() === 'warning') console.log(label, 'console', m.type(), m.text().slice(0, 300)); });
+  await page.setContent('<!doctype html><title>cap</title>');
+  await page.addScriptTag({ content: code });
+  const t1 = Date.now();
+  const r = await page.evaluate((a) => window.GpRef.capture(a), { views, lean: Number(lean), vehicle, flags: JSON.parse(flagsJson) });
+  for (const o of r.out) writeFileSync(`${out}-${o.view}-${label}.png`, Buffer.from(o.image.split(',')[1], 'base64'));
+  console.log(label, 'captured', ((Date.now() - t1) / 1000).toFixed(0), 's', 'tris', r.triangles, 'glError', r.glError, 'programs', r.programs);
+  await page.close();
+}
+await Promise.race([browser.close(), new Promise((r) => setTimeout(r, 15000))]);
+process.exit(0);
