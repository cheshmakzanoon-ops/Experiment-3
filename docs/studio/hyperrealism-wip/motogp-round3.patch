+// Scratch reference-scene fixture for A/B (works on any tree: features that do not exist yet are skipped).
+import * as T from 'three';
+import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
+import { BikeMaterials, BikeModel, staticSag, type BikePoseValues } from '../../src/rendering/bike.ts';
+import * as occ from '../../src/rendering/gp-occlusion.ts';
+import * as app from '../../src/rendering/gp-appearance.ts';
+import { VEHICLES } from '../../src/simulation/vehicles.ts';
+
+type V = { pos: [number, number, number]; at: [number, number, number]; fov: number };
+const VIEWS: Record<string, V> = {
+  'three-quarter': { pos: [-2.8, 1.65, 3.35], at: [0, 0.68, 0], fov: 38 },
+  side: { pos: [3.7, 1.35, 0.1], at: [0, 0.68, 0], fov: 38 },
+  'side-low': { pos: [2.2, 0.75, 0.2], at: [0, 0.55, 0.05], fov: 40 },
+  'front-q': { pos: [1.5, 0.9, 2.2], at: [0, 0.55, 0.55], fov: 36 },
+  'front-brake': { pos: [1.05, 0.65, 1.0], at: [0, 0.34, 0.75], fov: 35 },
+  'fork-top': { pos: [0.7, 1.0, 1.6], at: [0, 0.78, 0.7], fov: 30 },
+  'rear-chassis': { pos: [1.35, 0.8, -1.62], at: [0, 0.53, -0.37], fov: 35 },
+  'rear-q': { pos: [-1.9, 1.2, -2.4], at: [0, 0.6, -0.2], fov: 36 },
+  chase: { pos: [0.4, 1.55, -3.4], at: [0, 0.8, 0], fov: 34 },
+  'rider-rear': { pos: [-1.45, 1.65, -1.85], at: [0, 1.03, -0.15], fov: 32 },
+  'rider-side': { pos: [2.35, 1.45, 0], at: [0, 1.0, -0.08], fov: 32 },
+  'wheel-lip': { pos: [0.9, 0.5, 1.35], at: [0, 0.32, 0.78], fov: 28 },
+  'front-wheel-side': { pos: [1.35, 0.42, 0.78], at: [0, 0.33, 0.78], fov: 32 },
+  'rear-wheel': { pos: [1.2, 0.5, -1.35], at: [0, 0.33, -0.78], fov: 32 },
+  'nose-close': { pos: [0.55, 0.62, 1.55], at: [0, 0.5, 0.8], fov: 30 },
+  'flank-close': { pos: [1.1, 0.5, 0.45], at: [0, 0.35, 0.25], fov: 30 },
+  'tail-close': { pos: [0.7, 0.95, -1.2], at: [0, 0.75, -0.7], fov: 30 },
+};
+
+export function capture(o: {
+  views: string[];
+  flags?: { occlusion?: boolean; aniso?: boolean; relief?: number };
+  lean?: number;
+  vehicle?: string;
+  width?: number;
+  height?: number;
+  env?: number;
+}) {
+  const width = o.width ?? 1280,
+    height = o.height ?? 800,
+    lean = o.lean ?? 0,
+    flags = { occlusion: true, aniso: true, relief: 1, ...o.flags };
+  const renderer = new T.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
+  renderer.setSize(width, height);
+  renderer.setPixelRatio(1);
+  renderer.outputColorSpace = T.SRGBColorSpace;
+  renderer.toneMapping = T.ACESFilmicToneMapping;
+  renderer.shadowMap.enabled = true;
+  renderer.shadowMap.type = T.PCFSoftShadowMap;
+  const scene = new T.Scene();
+  scene.background = new T.Color('#aab9c6');
+  const pmrem = new T.PMREMGenerator(renderer);
+  scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.06).texture;
+  scene.environmentIntensity = o.env ?? 0.55;
