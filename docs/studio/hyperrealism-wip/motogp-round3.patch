+// Long-lived capture session: boots the race once, then runs plan files dropped into <cmdDir>.
+// node session.mjs <outDir> <cmdDir> <bootJson> [--port 5184]
+// Each plan file: {"shots":[...], "evals":[...]} ; results: <plan>.done.  Create <cmdDir>/STOP to quit.
+// The shared heavy lock is held only while booting and while each plan file runs.
+import { chromium } from '/home/user/Experiment-3/node_modules/playwright/index.mjs';
+import { writeFileSync, mkdirSync, readFileSync, readdirSync, existsSync } from 'node:fs';
+import { spawn } from 'node:child_process';
+const [out, cmdDir, bootArg, ...rest] = process.argv.slice(2);
+const port = rest.includes('--port') ? rest[rest.indexOf('--port') + 1] : '5184';
+const LOCK = '/tmp/claude-0/-home-user-Experiment-3/77bc90d5-fa90-573c-91d6-9e500a2bf2c9/scratchpad/heavy.lock';
+const boot = JSON.parse(existsSync(bootArg) ? readFileSync(bootArg, 'utf8') : bootArg);
+mkdirSync(out, { recursive: true });
+mkdirSync(cmdDir, { recursive: true });
+const t0 = Date.now();
+const log = (...m) => console.log(`[${((Date.now() - t0) / 1000).toFixed(0)}s]`, ...m);
+async function withLock(label, fn) {
+  const child = spawn('flock', [LOCK, 'bash', '-c', 'echo LOCKED; cat >/dev/null'], { stdio: ['pipe', 'pipe', 'inherit'] });
+  await new Promise((resolve) => child.stdout.once('data', resolve));
+  log('lock acquired for', label);
+  try {
+    return await fn();
+  } finally {
+    child.stdin.end();
+    log('lock released after', label);
+  }
+}
+const browser = await chromium.launch({
+  executablePath: '/opt/pw-browsers/chromium-1243/chrome-linux64/chrome',
+  args: ['--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--disable-gpu-watchdog', '--gpu-watchdog-timeout-seconds=3600', '--js-flags=--max-old-space-size=3072'],
+});
+const page = await browser.newPage({ viewport: { width: boot.width ?? 960, height: boot.height ?? 540 }, deviceScaleFactor: 1 });
+const errors = [];
+page.on('console', (m) => {
+  const text = m.text();
+  if (text.startsWith('GPCAP')) log(text);
+  else if (m.type() === 'error' || m.type() === 'warning') errors.push(`${m.type()}: ${text.slice(0, 300)}`);
+});
+page.on('pageerror', (e) => log('pageerror', e.message.slice(0, 300)));
+page.on('crash', () => { log('PAGE CRASHED (likely OOM)'); process.exit(3); });
+let outDir = out;
+await page.exposeFunction('saveCapture', (name, url) => {
+  writeFileSync(`${outDir}/${name}`, Buffer.from(url.split(',')[1], 'base64'));
+  log('wrote', `${outDir}/${name}`);
+});
+async function main() {
+  await page.goto(`http://127.0.0.1:${port}/test-results/gp-capture/index.html`, { timeout: 600000 });
+  await page.waitForFunction(() => window.GPCapReady === true, null, { timeout: 900000, polling: 1000 });
+  log('module ready');
+  const b = await withLock('boot', () => page.evaluate((o) => window.GPCap.boot(o), boot));
+  log('booted', JSON.stringify(b));
+  const done = new Set();
+  let idle = 0;
+  for (;;) {
+    if (existsSync(`${cmdDir}/STOP`)) break;
+    const files = readdirSync(cmdDir).filter((f) => f.endsWith('.json') && !done.has(f)).sort();
+    if (!files.length) {
+      if (++idle > 3 * 3600 / 5) break;
+      await new Promise((r) => setTimeout(r, 5000));
+      continue;
+    }
+    idle = 0;
+    const f = files[0];
+    done.add(f);
+    let plan;
+    try {
+      plan = JSON.parse(readFileSync(`${cmdDir}/${f}`, 'utf8'));
+    } catch (e) {
+      log('bad plan', f, e.message);
+      continue;
+    }
+    outDir = plan.out ?? out;
+    mkdirSync(outDir, { recursive: true });
+    await withLock(f, async () => {
+      for (const code of plan.evals ?? []) {
+        try {
+          const r = await page.evaluate((c) => new Function('cap', `return (async()=>{${c}})()`)(window.GPCap), code);
+          log('eval ok', JSON.stringify(r) ?? '');
+        } catch (e) {
+          log('eval error', e.message.slice(0, 300));
+        }
+      }
+      for (const shot of plan.shots ?? []) {
+        try {
+          await page.evaluate((s) => window.GPCap.shoot(s), shot);
+        } catch (e) {
+          log('shot error', shot.name, e.message.slice(0, 300));
+        }
+      }
+    });
+    writeFileSync(`${cmdDir}/${f}.done`, 'done');
+    log('plan done', f);
+  }
+}
+try {
+  await main();
+} catch (e) {
+  log('SESSION ERROR', e.message.slice(0, 500));
+} finally {
+  log('errors', JSON.stringify([...new Set(errors)].slice(0, 12)));
+  await Promise.race([browser.close(), new Promise((r) => setTimeout(r, 15000))]);
+  process.exit(0);
+}
