+// node run.mjs <outDir> <planJson|file> [--port 5182]
+// plan = { boot: {...}, shots: [ {name, view|photo, at, pre, frames} ] }
+import { chromium } from '/home/user/Experiment-3/node_modules/playwright/index.mjs';
+import { writeFileSync, mkdirSync, readFileSync, existsSync } from 'node:fs';
+const [out, planArg, ...rest] = process.argv.slice(2);
+const port = rest.includes('--port') ? rest[rest.indexOf('--port') + 1] : '5182';
+const plan = JSON.parse(existsSync(planArg) ? readFileSync(planArg, 'utf8') : planArg);
+mkdirSync(out, { recursive: true });
+const t0 = Date.now();
+const log = (...m) => console.log(`[${((Date.now() - t0) / 1000).toFixed(0)}s]`, ...m);
+const browser = await chromium.launch({
+  executablePath: '/opt/pw-browsers/chromium-1243/chrome-linux64/chrome',
+  args: ['--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader', '--disable-gpu-watchdog', '--gpu-watchdog-timeout-seconds=3600', '--js-flags=--max-old-space-size=3072'],
+});
+const page = await browser.newPage({ viewport: { width: plan.boot.width ?? 960, height: plan.boot.height ?? 540 }, deviceScaleFactor: 1 });
+const errors = [];
+page.on('console', (m) => {
+  const text = m.text();
+  if (text.startsWith('GPCAP')) log(text);
+  else if (m.type() === 'error' || m.type() === 'warning') errors.push(`${m.type()}: ${text.slice(0, 400)}`);
+});
+page.on('pageerror', (e) => errors.push('pageerror: ' + e.message));
+page.on('crash', () => { console.log('PAGE CRASHED (likely OOM)'); process.exit(3); });
+await page.exposeFunction('saveCapture', (name, url) => {
+  writeFileSync(`${out}/${name}`, Buffer.from(url.split(',')[1], 'base64'));
+  log('wrote', `${out}/${name}`);
+});
+try {
+  await page.goto(`http://127.0.0.1:${port}/test-results/gp-capture/index.html`, { timeout: 600000 });
+  await page.waitForFunction(() => window.GPCapReady === true, null, { timeout: 900000, polling: 1000 });
+  log('module ready');
+  const b = await page.evaluate((o) => window.GPCap.boot(o), plan.boot);
+  log('booted', JSON.stringify(b));
+  for (const shot of plan.shots) {
+    try {
+      await page.evaluate((s) => window.GPCap.shoot(s), shot);
+    } catch (e) {
+      errors.push(`shot ${shot.name}: ${e.message}`);
+    }
+  }
+} catch (e) {
+  errors.push('runner: ' + (e instanceof Error ? e.message : String(e)));
+} finally {
+  const unique = [...new Set(errors)];
+  log('console errors/warnings:', unique.length);
+  for (const e of unique.slice(0, 40)) console.log('  ', e);
+  await Promise.race([browser.close(), new Promise((r) => setTimeout(r, 15000))]);
+  process.exit(0);
+}
