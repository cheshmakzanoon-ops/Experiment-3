+/** Local GP look-development capture (not committed): production Simulation + RacingRenderer in a live GP
+ * race (AI rides the player bike), one boot then many shots. Ported from e2e/fixtures/motogp-hyperreal-capture.ts. */
+import { Simulation } from '../../src/simulation/world.ts';
+import { DEFAULT_OPTIONS } from '../../src/simulation/config.ts';
+import { RacingRenderer, type CameraMode } from '../../src/rendering/renderer.ts';
+import { graphicsPreset, type QualityPreset } from '../../src/rendering/options.ts';
+import { F, B, H, BIKE_BASE, carBase } from '../../src/simulation/protocol.ts';
+import { GpuFrameGate } from '../../src/rendering/gpu-frame-gate.ts';
+import { DEFAULT_PHOTO, type PhotoSettings } from '../../src/rendering/photo-camera.ts';
+import * as T from 'three';
+
+interface BootOptions {
+  preset: QualityPreset;
+  width: number;
+  height: number;
+  circuit?: string;
+  vehicles?: string[];
+  opponents?: number;
+  weather?: 'clear' | 'rain';
+  seed?: number;
+  crowd?: boolean;
+  vegetation?: number;
+  /** Simulated seconds before the first frame. */
+  warm?: number;
+  lighting?: string;
+  grid?: boolean;
+}
+let sim: Simulation, renderer: RacingRenderer, canvas: HTMLCanvasElement;
+let previous: Float32Array, current: Float32Array;
+let clock = 0;
+let gate: GpuFrameGate;
+const step = 1 / 120;
+const yieldGpu = () => new Promise<void>((r) => setTimeout(r, 12));
+const log = (...a: unknown[]) => console.log('GPCAP', ...a);
+
+function advance(seconds: number) {
+  const ticks = Math.max(1, Math.round(seconds / step));
+  for (let i = 0; i < ticks; i++) sim.step(step);
+  previous = current;
+  current = sim.makeFrame();
+  clock += ticks * step;
+}
+async function settle() {
+  const t0 = performance.now();
+  while (!gate.ready()) {
+    if (performance.now() - t0 > 3600000) throw new Error('GPU frame not ready in 60 min');
+    await yieldGpu();
+  }
+  return (performance.now() - t0) / 1000;
+}
+async function boot(o: BootOptions) {
+  const t0 = performance.now();
+  const weather = o.weather ?? 'clear';
+  const opponents = o.opponents ?? 3;
+  const vehicles = o.vehicles ?? Array.from({ length: opponents + 1 }, (_, i) => (i % 2 ? 'gpr2' : 'gpr1'));
+  sim = new Simulation({
+    ...DEFAULT_OPTIONS,
+    circuit: (o.circuit ?? 'poggio-alto') as never,
+    mode: 'race',
+    laps: 3,
+    ruleset: 'gp-motorcycle',
+    vehicles,
+    weather,
+    compound: weather === 'rain' ? 'wet' : 'medium',
+    opponents,
+    seed: o.seed ?? 34100,
+  });
+  sim.autoPlayer = true;
+  canvas = document.createElement('canvas');
+  canvas.style.cssText = `display:block;width:${o.width}px;height:${o.height}px`;
+  document.body.append(canvas);
+  renderer = new RacingRenderer(canvas, sim.track);
+  renderer.setQuality(o.preset, {
+    ...graphicsPreset(o.preset),
+    resolutionScale: 1,
+    ...(o.crowd === undefined ? {} : { crowd: o.crowd }),
+    ...(o.vegetation === undefined ? {} : { vegetationDensity: o.vegetation }),
+  });
+  if (o.lighting) (renderer as unknown as { lighting: string }).lighting = o.lighting;
+  const internals = renderer as unknown as { gpuFrames: GpuFrameGate };
+  internals.gpuFrames.dispose();
+  gate = internals.gpuFrames = new GpuFrameGate(
+    renderer.renderer.getContext() as WebGL2RenderingContext,
+    undefined,
+    1000,
+    10000,
+    3600000,
+  );
+  // Capture-only: the production 45 s "GPU preparation" deadline cannot hold on a CPU rasteriser.
+  (renderer as unknown as { waitForPreparedFrame: unknown }).waitForPreparedFrame = async (
+    cancelled: () => boolean,
+    yieldFrame: () => Promise<void>,
+  ) => {
+    while (!cancelled() && !gate.ready()) await yieldFrame();
+  };
+  current = sim.makeFrame();
+  previous = current;
+  if (o.warm) advance(o.warm);
+  const prepared = await renderer.prepare(current, (m) => log('prepare:', m), () => false, yieldGpu);
+  if (!prepared) throw new Error('prepare cancelled');
+  log('prepared', ((performance.now() - t0) / 1000).toFixed(1), 's');
+  return { prepareS: (performance.now() - t0) / 1000, tris: renderer.renderer.info.render.triangles };
+}
+
+export interface ShotSpec {
+  name: string;
+  view?: CameraMode;
+  photo?: Partial<PhotoSettings>;
+  /** Advance the race to this sim time first (s). */
+  at?: number;
+  /** JS run (as a Function of `cap`) before the shot, after the camera is set. */
+  pre?: string;
+  frames?: number;
+  jpeg?: boolean;
+  /** Re-draw the current instant: the simulation is not advanced (identical scene for A/B variants). */
+  freeze?: boolean;
+  /** Keep the camera as the previous shot left it (no mode change; for A/B on a held view). */
+  hold?: boolean;
+}
+async function shoot(s: ShotSpec) {
+  const t0 = performance.now();
+  if (s.at !== undefined && s.at > clock) advance(s.at - clock);
+  if (s.hold) {
+    /* camera untouched */
+  } else if (s.photo) renderer.setPhoto({ ...DEFAULT_PHOTO, ...s.photo } as PhotoSettings, current[H.CARS]);
+  else {
+    renderer.setPhoto(null);
+    renderer.changeCamera(s.view ?? 'chase');
+  }
+  if (s.pre) await new Function('cap', `return (async()=>{${s.pre}})()`)(api);
+  const frames = s.frames ?? 6;
+  if (s.freeze) previous = current;
+  for (let f = 0; f < frames; f++) {
+    if (!s.freeze) advance(1 / 12);
+    renderer.draw(previous, current, 1, 1 / 12, false);
+    if (f === 0) log('first frame', s.name, (await settle()).toFixed(1), 's');
+  }
+  await settle();
+  let image = '';
+  let luma = 0;
+  for (let attempt = 0; attempt < 4; attempt++) {
+    // Draw and read back in ONE task (the drawing buffer is cleared once presented).
+    await settle();
+    if (!s.freeze) advance(1 / 60);
+    renderer.draw(previous, current, 1, 1 / 60, false);
+    const gl = renderer.renderer.getContext();
+    const px = new Uint8Array(4);
+    let sum = 0;
+    for (let gy = 1; gy < 8; gy++)
+      for (let gx = 1; gx < 8; gx++) {
+        gl.readPixels(Math.floor((canvas.width * gx) / 8), Math.floor((canvas.height * gy) / 8), 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px);
+        sum += px[0] + px[1] + px[2];
+      }
+    luma = sum / 49 / 3;
+    image = canvas.toDataURL(s.jpeg ? 'image/jpeg' : 'image/png', 0.93);
+    if (luma > 1) break;
+    log('black read-back, retrying', s.name, attempt);
+  }
+  const base = carBase(0);
+  const info = {
+    name: s.name,
+    sec: (performance.now() - t0) / 1000,
+    clock,
+    luma,
+    speedKph: current[base + F.SPEED] * 3.6,
+    leanDeg: (current[base + BIKE_BASE + B.LEAN] * 180) / Math.PI,
+    calls: renderer.renderer.info.render.calls,
+    tris: renderer.renderer.info.render.triangles,
+  };
+  await (globalThis as { saveCapture?: (n: string, u: string) => Promise<void> }).saveCapture?.(
+    `${s.name}.${s.jpeg ? 'jpg' : 'png'}`,
+    image,
+  );
+  log('shot', JSON.stringify(info));
+  return info;
+}
+const api = {
+  boot,
+  shoot,
+  advance,
+  get renderer() {
+    return renderer;
+  },
+  get sim() {
+    return sim;
+  },
+  T,
+  /** Run-time override of the GP occlusion strengths on every entrant (null restores the product values). */
+  occlusion(diffuse: number | null, specular = diffuse) {
+    const seen = new Set<unknown>();
+    let patched = 0;
+    for (const m of api.materials()) {
+      const u = (renderer.renderer.properties.get(m) as { uniforms?: Record<string, { value: T.Vector3 }> })
+        .uniforms?.gpOccParams;
+      if (!u || seen.has(u)) continue;
+      seen.add(u);
+      const v = u.value as T.Vector3 & { __ov?: [number, number] | null };
+      if (!('__ov' in v)) {
+        let x = v.x, y = v.y;
+        v.__ov = null;
+        Object.defineProperty(v, 'x', { get: () => (v.__ov ? v.__ov[0] : x), set: (n: number) => (x = n), configurable: true });
+        Object.defineProperty(v, 'y', { get: () => (v.__ov ? v.__ov[1] : y), set: (n: number) => (y = n), configurable: true });
+      }
+      v.__ov = diffuse === null ? null : [diffuse, specular ?? diffuse];
+      patched++;
+    }
+    return patched;
+  },
+  /** Force a numeric (or Vector3-axis) uniform of every entrant to `value` (null restores). */
+  force(name: string, value: number | null) {
+    const seen = new Set<unknown>();
+    let patched = 0;
+    for (const m of api.materials()) {
+      const u = (renderer.renderer.properties.get(m) as { uniforms?: Record<string, { value: unknown }> }).uniforms?.[name];
+      if (!u || seen.has(u)) continue;
+      seen.add(u);
+      const holder = u as { value: unknown; __ov?: number | null; __stored?: unknown };
+      if (!('__ov' in holder)) {
+        holder.__stored = holder.value;
+        holder.__ov = null;
+        Object.defineProperty(holder, 'value', {
+          get: () => (holder.__ov !== null && holder.__ov !== undefined ? holder.__ov : holder.__stored),
+          set: (n: unknown) => (holder.__stored = n),
+          configurable: true,
+        });
+      }
+      holder.__ov = value;
+      patched++;
+    }
+    return patched;
+  },
+  /** Metal anisotropy forced off (0) / on (null restores the product value). */
+  aniso(strength: number | null) {
+    const proto = Object.getOwnPropertyDescriptor(T.MeshPhysicalMaterial.prototype, 'anisotropy')!;
+    let n = 0;
+    for (const m of api.materials()) {
+      if (!(m instanceof T.MeshPhysicalMaterial) || typeof m.userData.gpAnisotropy !== 'number') continue;
+      const holder = m as T.MeshPhysicalMaterial & { __ov?: number | null };
+      if (!('__ov' in holder)) {
+        Object.defineProperty(holder, 'anisotropy', {
+          get: () => (holder.__ov !== null && holder.__ov !== undefined ? holder.__ov : proto.get!.call(holder)),
+          set: (v: number) => proto.set!.call(holder, v),
+          configurable: true,
+        });
+      }
+      holder.__ov = strength;
+      m.needsUpdate = true;
+      n++;
+    }
+    return n;
+  },
+  /** Show or hide the rolled panel hems (draw range of the hem strips). */
+  hems(on: boolean) {
+    let n = 0;
+    renderer.scene.traverse((o) => {
+      const g = (o as T.Mesh).geometry as T.BufferGeometry | undefined;
+      const start = g?.userData?.gpHemStart;
+      if (typeof start === 'number') {
+        g!.setDrawRange(0, on ? Infinity : start);
+        n++;
+      }
+    });
+    return n;
+  },
+  /** All materials of the scene (deduplicated), for run-time tuning. */
+  materials() {
+    const set = new Set<T.Material>();
+    renderer.scene.traverse((o) => {
+      const m = (o as T.Mesh).material;
+      if (Array.isArray(m)) m.forEach((x) => set.add(x));
+      else if (m) set.add(m);
+    });
+    return [...set];
+  },
+};
+(window as unknown as { GPCap: unknown }).GPCap = api;
+(window as unknown as { GPCapReady: boolean }).GPCapReady = true;
