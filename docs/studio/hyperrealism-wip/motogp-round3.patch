+# cmp3.py out.png a.png b.png [x0 y0 x1 y1] [scale] [label_a label_b]
+# side by side A | B | amplified abs-diff (x4), optional crop and scale.
+import sys
+from PIL import Image, ImageChops, ImageDraw
+import numpy as np
+args = sys.argv[1:]
+out, a, b = args[:3]
+rest = args[3:]
+A = Image.open(a).convert('RGB'); B = Image.open(b).convert('RGB')
+if len(rest) >= 4 and all(r.lstrip('-').isdigit() for r in rest[:4]):
+    box = tuple(int(v) for v in rest[:4]); A = A.crop(box); B = B.crop(box); rest = rest[4:]
+scale = float(rest[0]) if rest else 1.0
+la = rest[1] if len(rest) > 1 else 'A'; lb = rest[2] if len(rest) > 2 else 'B'
+d = np.abs(np.asarray(A, dtype=np.int16) - np.asarray(B, dtype=np.int16))
+D = Image.fromarray(np.clip(d * 4, 0, 255).astype(np.uint8))
+w, h = A.size
+o = Image.new('RGB', (w * 3 + 12, h + 14), (255, 255, 255))
+for i, im in enumerate((A, B, D)): o.paste(im, (i * (w + 6), 14))
+dr = ImageDraw.Draw(o)
+for i, t in enumerate((la, lb, 'diff x4')): dr.text((i * (w + 6) + 3, 1), t, fill=(0, 0, 0))
+if scale != 1.0: o = o.resize((int(o.width * scale), int(o.height * scale)), Image.LANCZOS)
+o.save(out)
+print('mean abs diff', float(d.mean()), 'max', int(d.max()), 'pixels>8:', int((d.max(axis=2) > 8).sum()))
