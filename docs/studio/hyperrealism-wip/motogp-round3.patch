+#!/bin/bash
+# mksnap.sh <name>: copy the current worktree sources into scratchpad/motogp/<name> (symlinks for the heavy read-only dirs)
+set -e
+WT=/home/user/Experiment-3/.claude/worktrees/agent-a98ba1889308b2f68
+DST=/tmp/claude-0/-home-user-Experiment-3/77bc90d5-fa90-573c-91d6-9e500a2bf2c9/scratchpad/motogp/$1
+mkdir -p $DST/test-results
+rm -rf $DST/src; cp -a $WT/src $DST/src
+for f in index.html vite.config.ts package.json package-lock.json tsconfig.json; do cp $WT/$f $DST/$f; done
+for d in public scripts node_modules; do [ -e $DST/$d ] || ln -s $( [ $d = node_modules ] && echo /home/user/Experiment-3/node_modules || echo $WT/$d ) $DST/$d; done
+rm -rf $DST/test-results/gp-capture; cp -a $WT/test-results/gp-capture $DST/test-results/gp-capture
+cat > $DST/test-results/gp-capture/vite.capture.config.ts <<'EOT'
+import { mergeConfig } from 'vite';
+import base from '../../vite.config.ts';
+export default mergeConfig(base, { server: { hmr: false, fs: { allow: ['/home/user/Experiment-3', '.'] } } });
+EOT
+echo "snapshot $1 ready"
