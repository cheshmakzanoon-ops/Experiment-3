+      steer: sign * recorded.beforeBikeStep.bar,
+    };
+  Object.assign(gp, recorded.state);
+  for (const key of [
+    'lateralSpeed',
+    'yawRate',
+    'lateralAcceleration',
+    'frontFy',
+    'rearFy',
+  ] as const)
+    gp[key] *= sign;
+  return { gp, q };
+}
