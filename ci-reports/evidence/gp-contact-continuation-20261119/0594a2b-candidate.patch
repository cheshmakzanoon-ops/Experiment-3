From 0594a2b43b9a2769085efa1e1835243927fbb705 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Thu, 19 Nov 2026 15:10:44 -0700
Subject: [PATCH] Observe current GP contact strain in the roll forecast

Isolated current-history candidate on the AI contact handoff and single steering reserve. Keep the physical plant, final-force timing and gains unchanged. Native checks pass 67/67 and original Parco 5074 / Ardennes hairpin 1000 pass; original Vellamar 5222 still has one fall, so the candidate remains unaccepted.
---
 src/simulation/bike.ts                     |  31 +-
 src/simulation/motogp-physics.ts           |  71 +++++
 tests/fixtures/gp-ardennes-load-phase.json | 287 +++++++++++++++++++
 tests/gp-current-contact-control.test.ts   |  34 ++-
 tests/gp-current-history.test.ts           | 312 +++++++++++++++++++++
 5 files changed, 733 insertions(+), 2 deletions(-)
 create mode 100644 tests/fixtures/gp-ardennes-load-phase.json
 create mode 100644 tests/gp-current-history.test.ts

diff --git a/src/simulation/bike.ts b/src/simulation/bike.ts
index 6a78eaa..721d56a 100644
--- a/src/simulation/bike.ts
+++ b/src/simulation/bike.ts
@@ -462,12 +462,41 @@ export class Bike {
     // The present roll acceleration (from the measured tyre force) carries
     // the roll rate on for that lag too.
     const measured = gp.lateralAcceleration,
+      // Suspension has already supplied this step's contact loads. Observe
+      // the stored tyre strain under that same preparation, without taking
+      // another relaxation step or changing the pedal/steering state.
+      currentLateral = this.contactLoads
+        ? gp.currentLateralAcceleration({
+            speed: this.speed,
+            mass: m,
+            lean: this.lean,
+            steer: this.steer,
+            frontLoad: this.frontLoad,
+            rearLoad: this.rearLoad,
+            frontMu,
+            rearMu,
+            frontFx: -this.frontBrakeForce,
+            rearFx: this.driveForce - this.rearBrakeForce,
+            frontContact: clamp(
+              this.frontLoad /
+                Math.max(
+                  1,
+                  0.05 *
+                    ((m * G * p.cgToRear) / p.wheelbase +
+                      (p.downforce ?? 0) * this.speed * this.speed * (p.downforceFront ?? 0.6)),
+                ),
+              0,
+              1,
+            ),
+          })
+        : measured,
       cornering = Math.max(4000, gp.frontStiffness),
       // The front-force steering answers within a relaxation length, so the
       // look-ahead is short; rateGain·lead < 1 keeps the measured-force
       // prediction from feeding a step-to-step oscillation.
       lag = GP_ASSIST.lead,
-      rolling = (m * h * (reaction * Math.sin(psi) - measured * Math.cos(psi)) - gyro) / inertia,
+      rolling =
+        (m * h * (reaction * Math.sin(psi) - currentLateral * Math.cos(psi)) - gyro) / inertia,
       rateAhead = this.leanRate + lag * rolling,
       ahead = psi + lag * this.leanRate + 0.5 * lag * lag * rolling,
       error = target - ahead,
diff --git a/src/simulation/motogp-physics.ts b/src/simulation/motogp-physics.ts
index db3adc5..09b74a3 100644
--- a/src/simulation/motogp-physics.ts
+++ b/src/simulation/motogp-physics.ts
@@ -185,6 +185,7 @@ export class MotoGPChassis {
   /** Independent inverse scratch: trial steering must not rewrite the
    * actual contact's slip/force/thermal reporting state. */
   private readonly inverseFront = slipState();
+  private readonly previewFront = slipState();
   private readonly previewRear = slipState();
   private readonly inverseForces = new Float64Array(17);
 
@@ -391,6 +392,76 @@ export class MotoGPChassis {
     return 0.5 * (lo + hi);
   }
 
+  /** Observe stored contact strain under the CURRENT load/friction and bar
+   * pose, with no time or relaxation advance. This road-contact observation
+   * is the zero-time preparation state used by step(), not its future force
+   * after the rider has chosen new bars or TC/ABS has allocated new pedals. */
+  currentLateralAcceleration(
+    q: Pick<
+      MotoGPContactStep,
+      | 'speed'
+      | 'mass'
+      | 'lean'
+      | 'steer'
+      | 'frontLoad'
+      | 'rearLoad'
+      | 'frontMu'
+      | 'rearMu'
+      | 'frontFx'
+      | 'rearFx'
+      | 'frontContact'
+    >,
+  ) {
+    if (q.speed < 2.5) return 0;
+    const ground = gpGroundSteer(q.steer, q.lean),
+      front = this.preparedHistoryForce(
+        this.previewFront,
+        q.frontLoad * clamp(q.frontContact, 0, 1),
+        q.frontMu,
+        q.lean,
+        q.frontFx,
+        this.frontFy,
+        this.frontElasticStiffness,
+        ground,
+      ),
+      rear = this.preparedHistoryForce(
+        this.previewRear,
+        q.rearLoad,
+        q.rearMu,
+        q.lean,
+        q.rearFx,
+        this.rearFy,
+        this.rearElasticStiffness,
+        0,
+      );
+    return (front + rear) / Math.max(1, q.mass);
+  }
+
+  private preparedHistoryForce(
+    state: ReturnType<typeof slipState>,
+    load: number,
+    mu: number,
+    lean: number,
+    longitudinal: number,
+    force: number,
+    stiffness: number,
+    steer: number,
+  ) {
+    if (!(load > 1 && mu > 0)) return 0;
+    prepareSlip(MOTOGP_SLICK, load, Math.max(0.05, mu) * gpCamberFriction(lean), 1, 1, 1, state);
+    // This early observer receives the prior force pair, before current
+    // TC/ABS allocation. Unlike step(), it cannot assume that old Fx is
+    // still transmissible after unloading or a grip change. Reinterpret it
+    // inside the current circle without modifying the actual pedal forces.
+    const transmitted = clamp(longitudinal, -state.dy, state.dy),
+      carried =
+        stiffness > 0 && state.corneringStiffness !== stiffness
+          ? (force * state.corneringStiffness) / stiffness
+          : force,
+      limit = Math.sqrt(Math.max(0, state.dy ** 2 - transmitted ** 2));
+    return clamp(carried, -limit, limit) * Math.cos(steer) + transmitted * Math.sin(steer);
+  }
+
   /** Predict the rear force the next contact evaluation will actually apply,
    * including current support, combined slip, carcass relaxation and the
    * immediate friction clamp. This does not advance any physical state. */
