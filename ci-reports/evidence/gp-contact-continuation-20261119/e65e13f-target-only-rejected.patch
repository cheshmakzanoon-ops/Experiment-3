diff --git a/src/simulation/bike.ts b/src/simulation/bike.ts
index 721d56a..e29d3e8 100644
--- a/src/simulation/bike.ts
+++ b/src/simulation/bike.ts
@@ -418,6 +418,21 @@ export class Bike {
       Math.min(front / ((m * p.cgToRear) / p.wheelbase), rear / ((m * p.cgToFront) / p.wheelbase)),
     );
   }
+  /** Only admission of a new lean uses this history. The dimensionless
+   * force/reaction ratio preserves common-mode changes of normal support. */
+  private gpAdmittedSupportRatio = Infinity;
+  /** Current supported intent before admission. A more cautious new lean
+   * must not give its existing nominal cornering reserve back to the pedals. */
+  private gpReserveTarget = 0;
+  private gpSupportCapacity(frontMu: number, rearMu: number) {
+    const p = this.p;
+    return (
+      Math.min(
+        (frontMu * this.frontLoad * p.wheelbase) / (this.mass * p.cgToRear),
+        (rearMu * this.rearLoad * p.wheelbase) / (this.mass * p.cgToFront),
+      ) * gpCamberFriction(this.lean)
+    );
+  }
   /** GP lean-intent assist: handlebar angle that brings the combined CG lean
    * ψ to the rider's target. A roll-rate reference stays inside both the
    * rider's steering effort (gpRollRateLimit) and the energy the tyres can
@@ -447,16 +462,20 @@ export class Bike {
     // for this exact front/rear load pair; otherwise the rider asks for a
     // lean the saturated tyres cannot arrest. The standalone model retains
     // its original nominal-weight target.
-    const supportCapacity = this.contactLoads
-      ? Math.min(
-          (frontMu * this.frontLoad * p.wheelbase) / (m * p.cgToRear),
-          (rearMu * this.rearLoad * p.wheelbase) / (m * p.cgToFront),
-        ) * gpCamberFriction(this.lean)
-      : Infinity;
+    const supportCapacity = this.contactLoads ? this.gpSupportCapacity(frontMu, rearMu) : Infinity;
     const supportedLimit = this.contactLoads
       ? Math.atan2(GP_ASSIST.leanMargin * supportCapacity, reaction)
       : this.leanLimit;
-    const target = (gp.leanTarget = clamp(requestedTarget, -supportedLimit, supportedLimit));
+    this.gpReserveTarget = clamp(requestedTarget, -supportedLimit, supportedLimit);
+    // A returning contact ratio can disappear before the existing roll-rate
+    // response answers. Admit that increase over its response time, while
+    // retaining current reaction, stopping work and full arrest capacity.
+    // Preserve the original atan2 arithmetic when admission is nonbinding.
+    const admittedLimit =
+      this.contactLoads && this.gpAdmittedSupportRatio < supportCapacity / reaction
+        ? Math.atan2(GP_ASSIST.leanMargin * this.gpAdmittedSupportRatio * reaction, reaction)
+        : supportedLimit;
+    const target = (gp.leanTarget = clamp(requestedTarget, -admittedLimit, admittedLimit));
     // The lateral force answers a steer change within a fraction of a second
     // (sideslip and yaw modes); plan from where the roll will be by then.
     // The present roll acceleration (from the measured tyre force) carries
@@ -606,6 +625,8 @@ export class Bike {
   resetRoadControl() {
     this.roadAdmittedCapacity = Infinity;
     this.roadLateralDemand = 0;
+    this.gpAdmittedSupportRatio = Infinity;
+    this.gpReserveTarget = 0;
   }
   private roadLateralCapacity(frontMu: number, rearMu: number) {
     const p = this.p,
@@ -670,7 +691,17 @@ export class Bike {
     if (contacts) {
       this.frontLoad = Math.max(0, contacts.front);
       this.rearLoad = Math.max(0, contacts.rear);
-      if (!this.motoGP) {
+      if (this.motoGP) {
+        const reaction = (this.frontLoad + this.rearLoad) / m,
+          ratio = reaction > 1e-6 ? this.gpSupportCapacity(frontMu, rearMu) / reaction : 0;
+        this.gpAdmittedSupportRatio = Number.isFinite(this.gpAdmittedSupportRatio)
+          ? Math.min(
+              ratio,
+              this.gpAdmittedSupportRatio +
+                (ratio - this.gpAdmittedSupportRatio) * (1 - Math.exp(-GP_ASSIST.rateGain * dt)),
+            )
+          : ratio;
+      } else {
         const capacity = this.roadLateralCapacity(frontMu, rearMu);
         // Lost support restricts admission immediately. Returning support
         // becomes dependable over the EXISTING 1/rateGain response time;
@@ -823,7 +854,7 @@ export class Bike {
                   1.3,
                   Math.max(
                     Math.abs(this.lean + gpHangOffAngle(this.riderOffset, p.cgHeight)),
-                    gpAssistLive ? Math.abs(this.motoGP.leanTarget) : 0,
+                    gpAssistLive ? Math.abs(this.gpReserveTarget) : 0,
                   ),
                 ),
               ),
