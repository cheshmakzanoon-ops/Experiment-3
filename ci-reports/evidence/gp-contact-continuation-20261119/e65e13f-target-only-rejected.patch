+import { describe, expect, it, vi } from 'vitest';
+import { DynamicsTrack } from '../scripts/dynamics-fixtures.ts';
+import { G } from '../src/core/math.ts';
+import { BIKE, Bike, EXPERT, GP_ASSIST, NOVICE, type BikeInput } from '../src/simulation/bike.ts';
+import { GP_R1 } from '../src/simulation/bike-definitions.ts';
+import { BikeVehicle } from '../src/simulation/bike-vehicle.ts';
+import { DEFAULT_SETUP } from '../src/simulation/config.ts';
+import { gpHangOffAngle, MotoGPChassis } from '../src/simulation/motogp-physics.ts';
+import recorded from './fixtures/gp-target-admission-onset.json';
+
+const neutral: BikeInput = {
+  lean: 0,
+  throttle: 0,
+  frontBrake: 0,
+  rearBrake: 0,
+  rider: 0,
+  drive: 0,
+};
+const admitted = (bike: Bike): number => Reflect.get(bike, 'gpAdmittedSupportRatio');
+const reserveTarget = (bike: Bike): number => Reflect.get(bike, 'gpReserveTarget');
+
+function machine() {
+  const bike = new BikeVehicle(0, 'medium', DEFAULT_SETUP, 'sport', GP_R1).dynamics;
+  bike.assists = NOVICE;
+  bike.speed = 30;
+  bike.p.drag = bike.p.rolling = 0;
+  return bike;
+}
+
+describe('GP target admission keeps the current recovery budget', () => {
+  it.each([1 / 240, 1 / 120].flatMap((dt) => [0.1, 0.2, 0.3].map((period) => ({ dt, period }))))(
+    'keeps a new roll inside recurring support at period $period and dt $dt',
+    ({ dt, period }) => {
+      const bike = machine(),
+        front = bike.frontLoad,
+        rear = bike.rearLoad,
+        turning = { ...neutral, lean: 1, rider: 1 };
+      // Retain the previous native transient-support counterexamples. This
+      // trial restricts only the target, with no admitted-reaction/work filter.
+      for (let i = 0; i < 8 / dt; i++) {
+        const load = (i * dt) % period < period / 5 ? 0 : 1.5 * front;
+        bike.contactLoads = { front: load, rear };
+        bike.step(turning, dt);
+        expect(bike.state).toBe('riding');
+        expect(bike.frontLoad).toBe(load);
+        expect(bike.rearLoad).toBe(rear);
+        expect(Math.abs(bike.motoGP!.frontFy)).toBeLessThanOrEqual(bike.p.mu * load + 1e-9);
+        expect(Math.abs(bike.motoGP!.rearFy)).toBeLessThanOrEqual(bike.p.mu * rear + 1e-9);
+        if (load === 0) expect(admitted(bike)).toBe(0);
+      }
+      bike.contactLoads = { front, rear };
+      for (let i = 0; i < 4 / dt; i++) bike.step(turning, dt);
+      expect(bike.state).toBe('riding');
+      expect(bike.motoGP!.leanTarget).toBeCloseTo(reserveTarget(bike), 3);
+    },
+  );
+
+  it('preserves supported lean when both axle reactions change proportionally', () => {
+    const bike = machine(),
+      front = bike.frontLoad,
+      rear = bike.rearLoad;
+    let reference = 0;
+    for (let i = 0; i < 480; i++) {
+      const scale = i < 120 ? 1 : i < 240 ? 0.5 : i < 360 ? 1.5 : 2;
+      // Hold pose and physical intent fixed while only prescribed support
+      // changes; native controller history still advances on every step.
+      bike.speed = 30;
+      bike.lean = 0.35;
+      bike.leanRate = 0;
+      bike.riderOffset = 0.08;
+      bike.frontBrakeForce = bike.rearBrakeForce = bike.driveForce = 0;
+      bike.motoGP!.reset(bike.speed);
+      bike.contactLoads = { front: front * scale, rear: rear * scale };
+      bike.step({ ...neutral, lean: 1, rider: 0.08 / bike.p.riderOffsetMax }, 1 / 240);
+      if (i === 0) reference = bike.motoGP!.leanTarget;
+      expect(bike.motoGP!.leanTarget).toBeCloseTo(reference, 12);
+      expect(reserveTarget(bike)).toBeCloseTo(reference, 12);
+      expect(bike.frontLoad).toBe(front * scale);
+      expect(bike.rearLoad).toBe(rear * scale);
+    }
+  });
+
+  it.each(recorded.cases.flatMap((state) => [-1, 1].map((sign) => ({ sign, ...state }))))(
+    'arrests the saved onset earlier without releasing its pedal reserve at $tick/$substep, sign $sign',
+    (saved) => {
+      const state = JSON.parse(JSON.stringify(saved.state), (_, value) => {
+        if (value && typeof value === 'object' && value.typedArray === 'Float64Array')
+          return new Float64Array(value.values);
+        if (value === 'Infinity') return Infinity;
+        if (value === '-Infinity') return -Infinity;
+        if (value === 'NaN') return NaN;
+        return value;
+      });
+      const bike = Object.assign(new Bike(state.bike.assists, state.bike.p), state.bike),
+        gp = Object.assign(new MotoGPChassis(state.gp.geometry), state.gp);
+      bike.motoGP = gp;
+      for (const key of ['lean', 'leanRate', 'steer', 'riderOffset', 'heading'] as const)
+        bike[key] *= saved.sign;
+      for (const key of [
+        'lateralSpeed',
+        'yawRate',
+        'lateralAcceleration',
+        'frontFy',
+        'rearFy',
+        'steerTrim',
+        'groundSteer',
+        'leanTarget',
+      ] as const)
+        gp[key] *= saved.sign;
+      Reflect.set(bike, 'gpAdmittedSupportRatio', saved.admittedRatioBefore);
+      Reflect.set(bike, 'gpReserveTarget', -123); // Must be overwritten before allocation.
+      const plant = vi.spyOn(gp, 'step'),
+        inverse = vi.spyOn(gp, 'frontSteerFor'),
+        rearPreview = vi.spyOn(gp, 'rearForceFor'),
+        input = {
+          ...saved.input,
+          lean: saved.sign * saved.input.lean,
+          rider: saved.sign * saved.input.rider,
+        };
+      bike.step(input, saved.dt);
+      expect(plant).toHaveBeenCalledTimes(1);
+      expect(inverse).toHaveBeenCalledTimes(1);
+      expect(rearPreview).toHaveBeenCalledTimes(1);
+      expect(gp.leanTarget).toBeCloseTo(saved.sign * saved.expected.admittedTarget, 12);
+      expect(reserveTarget(bike)).toBe(saved.sign * saved.expected.originalTarget);
+      expect(Math.abs(gp.leanTarget)).toBeLessThan(Math.abs(reserveTarget(bike)));
+      const psi = state.bike.lean * saved.sign + gpHangOffAngle(bike.riderOffset, bike.p.cgHeight),
+        nominal =
+          G * Math.tan(Math.min(1.3, Math.max(Math.abs(psi), Math.abs(reserveTarget(bike))))),
+        q = plant.mock.calls[0][0];
+      expect(nominal).toBe(saved.expected.nominalReserve);
+      const frontRequest = (lateral: number) =>
+        bike.mass * saved.sign * lateral -
+        rearPreview.mock.results[0].value -
+        (GP_ASSIST.yawDamping *
+          gp.geometry.yawInertia *
+          saved.sign *
+          (state.gp.yawRate - lateral / Math.max(state.bike.speed, 3))) /
+          gp.geometry.frontArm;
+      expect(inverse.mock.calls[0][0]).toBeCloseTo(frontRequest(saved.expected.lateralAdmitted), 9);
+      expect(
+        saved.sign * (inverse.mock.calls[0][0] - frontRequest(saved.expected.lateralBefore)),
+      ).toBeGreaterThan(0.01);
+      // The preserved floor owns these two native allocations. Reducing it
+      // along with the target would give the pedals up to 3.312 m/s² back.
+      // JSON serializes the recorded zero front-brake force without its sign.
+      expect(q.frontFx).toBe(saved.expected.frontFx === 0 ? -0 : saved.expected.frontFx);
+      expect(q.rearFx).toBe(saved.expected.rearFx);
+      expect(q.frontLoad).toBe(saved.expected.frontLoad);
+      expect(q.rearLoad).toBe(saved.expected.rearLoad);
+      expect(bike.state).toBe('riding');
+    },
+  );
+
+  it('drops admission at lost support while allowing the full native landing force', () => {
+    const bike = machine(),
+      front = bike.frontLoad,
+      rear = bike.rearLoad,
+      dt = 1 / 240;
+    bike.contactLoads = { front, rear };
+    bike.step(neutral, dt);
+    const ratio = admitted(bike);
+    bike.contactLoads = { front: 0, rear: 0 };
+    bike.step({ ...neutral, throttle: 1, drive: 5000, frontBrake: 1, rearBrake: 1 }, dt);
+    expect(admitted(bike)).toBe(0);
+    expect(bike.driveForce + bike.frontBrakeForce + bike.rearBrakeForce).toBe(0);
+    expect(bike.motoGP!.frontFy).toBe(0);
+    expect(bike.motoGP!.rearFy).toBe(0);
+    bike.lean = 0.4;
+    bike.leanRate = 0.6;
+    bike.contactLoads = { front, rear };
+    bike.step(neutral, dt);
+    expect(admitted(bike)).toBeGreaterThan(0);
+    expect(admitted(bike)).toBeLessThan(ratio / 10);
+    const transmitted = Math.abs(bike.motoGP!.frontFy + bike.motoGP!.rearFy),
+      admittedForce = admitted(bike) * (front + rear);
+    expect(transmitted).toBeGreaterThan(admittedForce);
+    expect(bike.frontLoad).toBe(front);
+    expect(bike.rearLoad).toBe(rear);
+  });
+
+  it.each(['place', 'placeFree'] as const)('clears admission on explicit %s', (placement) => {
+    const track = new DynamicsTrack(),
+      used = new BikeVehicle(0, 'medium', DEFAULT_SETUP, 'sport', GP_R1),
+      fresh = new BikeVehicle(0, 'medium', DEFAULT_SETUP, 'sport', GP_R1);
+    used.dynamics.contactLoads = { front: 0, rear: 0 };
+    used.dynamics.step(neutral, 1 / 240);
+    expect(admitted(used.dynamics)).toBe(0);
+    for (const bike of [used, fresh]) {
+      if (placement === 'place') bike.place(track, 0);
+      else bike.placeFree(track, 0, 0, 0, 0);
+    }
+    expect(admitted(used.dynamics)).toBe(Infinity);
+    expect(reserveTarget(used.dynamics)).toBe(0);
+    used.step(1 / 240, track);
+    fresh.step(1 / 240, track);
+    expect(used.dynamics).toEqual(fresh.dynamics);
+  });
+
+  it('resets admission on remount and leaving optional road contact', () => {
+    const bike = machine();
+    bike.contactLoads = { front: 0, rear: 0 };
+    bike.step(neutral, 1 / 240);
+    bike.state = 'remount';
+    bike.stateClock = 1.5;
+    bike.speed = 0;
+    bike.riderReady = true;
+    bike.step(neutral, 1 / 240);
+    expect(bike.state).toBe('riding');
+    expect(admitted(bike)).toBe(Infinity);
+    expect(reserveTarget(bike)).toBe(0);
+    bike.step(neutral, 1 / 240);
+    expect(admitted(bike)).toBe(0);
+    bike.contactLoads = undefined;
+    bike.step(neutral, 1 / 240);
+    expect(admitted(bike)).toBe(Infinity);
+  });
+
+  it('does not consume stale target reserves when the GP assist is inactive', () => {
+    for (const mode of ['manual', 'walking', 'airborne'] as const) {
+      const a = machine(),
+        b = machine();
+      if (mode === 'manual') a.assists = b.assists = EXPERT;
+      if (mode === 'walking') a.speed = b.speed = 2;
+      a.contactLoads = b.contactLoads =
+        mode === 'airborne' ? { front: 0, rear: 0 } : { front: a.frontLoad, rear: a.rearLoad };
+      Reflect.set(a, 'gpReserveTarget', 1.2);
+      Reflect.set(b, 'gpReserveTarget', 0);
+      const input = { ...neutral, throttle: 1, drive: 2000, frontBrake: 0.3 };
+      a.step(input, 1 / 240);
+      b.step(input, 1 / 240);
+      expect(a.driveForce).toBe(b.driveForce);
+      expect(a.frontBrakeForce).toBe(b.frontBrakeForce);
+      expect(a.rearBrakeForce).toBe(b.rearBrakeForce);
+      expect(a.speed).toBe(b.speed);
+      expect(a.lean).toBe(b.lean);
+    }
+    const road = new Bike(NOVICE, BIKE);
+    road.speed = 30;
+    road.contactLoads = { front: road.frontLoad, rear: road.rearLoad };
+    road.step(neutral, 1 / 240);
+    expect(admitted(road)).toBe(Infinity);
+  });
+});
