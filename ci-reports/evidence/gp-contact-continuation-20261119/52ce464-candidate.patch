+    // A GP path request is acceleration, while a player's stick is lean.
+    // Suspension has just changed the reaction: carrying an old lean angle
+    // across it would multiply the AI's requested acceleration by the load
+    // change. Decode with the exact contacts Bike.step is about to consume,
+    // retaining its current lean/support clamps and raw-request reserves.
+    const contacts = d.contactLoads,
+      support = contacts ? Math.max(0, contacts.front) + Math.max(0, contacts.rear) : 0,
+      lean =
