diff --git a/tests/gp-ai-contact-phase.test.ts b/tests/gp-ai-contact-phase.test.ts
new file mode 100644
index 0000000..1a380d8
--- /dev/null
+++ b/tests/gp-ai-contact-phase.test.ts
@@ -0,0 +1,157 @@
+import { describe, expect, it, vi } from 'vitest';
+import { clamp, G } from '../src/core/math.ts';
+import { BikeAIDriver } from '../src/simulation/bike-ai.ts';
+import { GP_R1, SBK_1000 } from '../src/simulation/bike-definitions.ts';
+import { BikeVehicle } from '../src/simulation/bike-vehicle.ts';
+import { DEFAULT_OPTIONS, DEFAULT_SETUP } from '../src/simulation/config.ts';
+import { RaceDirector } from '../src/simulation/race.ts';
+import { Track } from '../src/simulation/track.ts';
+
+const DT = 1 / 240;
+
+/** Prescribe the signed path correction; the AI, suspension, physical
+ * controller, allocation, tyre contacts and roll plant remain native. */
+class DemandDriver extends BikeAIDriver {
+  constructor(
+    bike: BikeVehicle,
+    private readonly acceleration: number,
+  ) {
+    super(bike);
+  }
+  protected override steeringLineCurvature() {
+    return 0;
+  }
+  protected override pathCorrection() {
+    return this.acceleration / this.bike.dynamics.speed ** 2;
+  }
+}
+
+function fixture(ordinary = false) {
+  const track = new Track('clear', true),
+    bike = new BikeVehicle(0, 'medium', DEFAULT_SETUP, 'sport', ordinary ? SBK_1000 : GP_R1);
+  bike.place(track, 120);
+  bike.speed = bike.dynamics.speed = 30;
+  bike.input.steer = -0.15;
+  bike.input.throttle = 0;
+  bike.dynamics.motoGP?.reset(30);
+  return { bike, track, d: bike.dynamics };
+}
+
+describe('GP AI path acceleration belongs to the current contact step', () => {
+  it.each([-1, 1].flatMap((sign) => [0.4, 1.5].map((support) => ({ sign, support }))))(
+    'preserves signed demand $sign across a prior $support support fraction',
+    ({ sign, support }) => {
+      const { bike, track, d } = fixture(),
+        acceleration = sign * 6,
+        priorReaction = support * G;
+      d.frontLoad = (priorReaction * d.mass * d.p.cgToRear) / d.p.wheelbase;
+      d.rearLoad = (priorReaction * d.mass * d.p.cgToFront) / d.p.wheelbase;
+      d.contactLoads = { front: d.frontLoad, rear: d.rearLoad };
+      const driver = new DemandDriver(bike, acceleration),
+        race = new RaceDirector([bike], track, { ...DEFAULT_OPTIONS, mode: 'practice' });
+      driver.update(2 * DT, track, [bike], race);
+      bike.input.throttle = 0;
+      const authoredIntent = bike.input.steer,
+        step = vi.spyOn(d, 'step'),
+        plant = vi.spyOn(d.motoGP!, 'step');
+      bike.step(DT, track);
+      const delivered = step.mock.calls[0][0],
+        reaction = (d.frontLoad + d.rearLoad) / d.mass;
+      expect(Math.abs(reaction - priorReaction)).toBeGreaterThan(1);
+      expect(reaction * Math.tan(delivered.lean * d.leanLimit)).toBeCloseTo(acceleration, 3);
+      expect(reaction * Math.tan(d.motoGP!.leanTarget)).toBeCloseTo(acceleration, 10);
+      // The rider and the roll assist consume one selected request; the
+      // authored AI input remains available to telemetry without mutation.
+      expect(delivered.rider).toBeCloseTo(clamp(1.3 * delivered.lean, -1, 1), 12);
+      expect(bike.input.steer).toBe(authoredIntent);
+      expect(plant).toHaveBeenCalledTimes(1);
+      expect(d.state).toBe('riding');
+    },
+  );
+
+  it.each([-1, 1])('retains the current core lean and contact clamps for sign %s', (sign) => {
+    const { bike, track, d } = fixture();
+    bike.aiControlled(2, sign * 100);
+    const step = vi.spyOn(d, 'step');
+    bike.step(DT, track);
+    expect(step.mock.calls[0][0].lean).toBe(sign);
+    expect(Math.abs(d.motoGP!.leanTarget)).toBeLessThanOrEqual(d.leanLimit + 1e-5);
+    expect(Math.hypot(d.motoGP!.frontFy, d.frontBrakeForce)).toBeLessThanOrEqual(
+      d.p.mu * d.frontGrip! * d.frontLoad + 1e-9,
+    );
+    expect(Math.hypot(d.motoGP!.rearFy, d.driveForce - d.rearBrakeForce)).toBeLessThanOrEqual(
+      d.p.mu * d.rearGrip! * d.rearLoad + 1e-9,
+    );
+  });
+
+  it('re-encodes both actual contact substeps and expires at their boundary', () => {
+    const { bike, track, d } = fixture(),
+      acceleration = 6,
+      observed: { reaction: number; lean: number; limit: number }[] = [],
+      native = d.step.bind(d);
+    vi.spyOn(d, 'step').mockImplementation((input, dt) => {
+      observed.push({
+        reaction: (d.contactLoads!.front + d.contactLoads!.rear) / d.mass,
+        lean: input.lean,
+        limit: d.leanLimit,
+      });
+      return native(input, dt);
+    });
+    bike.aiControlled(2, acceleration);
+    bike.step(DT, track);
+    bike.step(DT, track);
+    bike.step(DT, track);
+    expect(observed[1].reaction).not.toBe(observed[0].reaction);
+    for (const row of observed.slice(0, 2))
+      expect(row.reaction * Math.tan(row.lean * row.limit)).toBeCloseTo(acceleration, 12);
+    expect(observed[2].lean).toBe(bike.input.steer);
+  });
+
+  it.each(['default mark', 'zero mark', 'placement', 'free placement', 'recovery'])(
+    'clears a pending path request at %s',
+    (boundary) => {
+      const { bike, track, d } = fixture();
+      bike.aiControlled(2, 6);
+      if (boundary === 'default mark') bike.aiControlled();
+      else if (boundary === 'zero mark') bike.aiControlled(0);
+      else if (boundary === 'placement') bike.place(track, 120);
+      else if (boundary === 'free placement')
+        bike.placeFree(track, d.x, d.z, d.heading, bike.body.position.y - d.p.cgHeight);
+      else {
+        d.fall('lowside');
+        bike.step(DT, track);
+        d.state = 'riding';
+      }
+      bike.speed = d.speed = 30;
+      const step = vi.spyOn(d, 'step');
+      bike.step(DT, track);
+      expect(step.mock.calls[0][0].lean).toBe(bike.input.steer);
+    },
+  );
+
+  it.each(['ordinary motorcycle', 'current low speed', 'manual'])(
+    'preserves the authored stick for %s',
+    (mode) => {
+      const { bike, track, d } = fixture(mode === 'ordinary motorcycle');
+      if (mode !== 'manual') bike.aiControlled(2, 6);
+      if (mode === 'current low speed') bike.speed = d.speed = 5.9;
+      const step = vi.spyOn(d, 'step');
+      bike.step(DT, track);
+      expect(step.mock.calls[0][0].lean).toBe(bike.input.steer);
+    },
+  );
+
+  it.each([0, NaN, Infinity])('does not re-encode with invalid support %s', (support) => {
+    const { bike, track, d } = fixture();
+    bike.aiControlled(2, 6);
+    // This boundary-only negative supplies invalid road data and intercepts
+    // the core input. Native positive controls above exercise real contacts.
+    const adapter = bike as unknown as { advanceRoadSuspension(dt: number, track: Track): void };
+    vi.spyOn(adapter, 'advanceRoadSuspension').mockImplementation(() => {
+      d.contactLoads = { front: support, rear: support };
+    });
+    const step = vi.spyOn(d, 'step').mockImplementation(() => d.state);
+    bike.step(DT, track);
+    expect(step.mock.calls[0][0].lean).toBe(bike.input.steer);
+  });
+});
