--- /dev/null
+++ b/tests/gp-signed-command.test.ts
@@ -0,0 +1,367 @@
+import { describe, expect, it, vi } from 'vitest';
+import { Bike, GP_ASSIST, type BikeInput } from '../src/simulation/bike.ts';
+import {
+  gpBarSteer,
+  MotoGPChassis,
+  type GPFrontForceRange,
+  type MotoGPContactStep,
+} from '../src/simulation/motogp-physics.ts';
+import { clamp } from '../src/core/math.ts';
+import saved from './fixtures/gp-signed-command-onset.json';
+
+type SavedCase = (typeof saved.cases)[number];
+const scratch = new Set(['force', 'inverseFront', 'previewFront', 'previewRear', 'inverseForces']);
+// The sealed JSON trace preserves every finite value, but JSON normalizes
+// signed zero. Compare its command/output records in that same encoding.
+const recorded = (value: unknown) => JSON.parse(JSON.stringify(value));
+function hydrate<T extends object>(target: T, source: object): T {
+  const fields = target as Record<string, unknown>;
+  for (const [key, value] of Object.entries(source)) {
+    const current = fields[key];
+    if (current instanceof Float64Array) current.set(Object.values(value));
+    else fields[key] = structuredClone(value);
+  }
+  return target;
+}
+function physical(gp: MotoGPChassis) {
+  return structuredClone(
+    Object.fromEntries(
+      Object.entries(gp).filter(([key, value]) => !scratch.has(key) && typeof value !== 'function'),
+    ),
+  );
+}
+function chassis(f: SavedCase) {
+  return hydrate(new MotoGPChassis(f.gp.geometry), f.gp);
+}
+function bike(f: SavedCase, standalone = false) {
+  const b = hydrate(new Bike(f.bike.assists, f.bike.p), f.bike);
+  b.motoGP = chassis(f);
+  b.riderOffset = f.stepEntry.riderOffset;
+  if (standalone) b.contactLoads = undefined;
+  return b;
+}
+function after(b: Bike) {
+  return {
+    speed: b.speed,
+    lean: b.lean,
+    leanRate: b.leanRate,
+    riderOffset: b.riderOffset,
+    steer: b.steer,
+    frontLoad: b.frontLoad,
+    rearLoad: b.rearLoad,
+    drive: b.driveForce,
+    frontBrake: b.frontBrakeForce,
+    rearBrake: b.rearBrakeForce,
+    state: b.state,
+    crashes: b.crashes,
+  };
+}
+function output(gp: MotoGPChassis) {
+  return {
+    frontFy: gp.frontFy,
+    rearFy: gp.rearFy,
+    lateralAcceleration: gp.lateralAcceleration,
+    frontOmega: gp.frontOmega,
+    rearOmega: gp.rearOmega,
+    yawRate: gp.yawRate,
+    lateralSpeed: gp.lateralSpeed,
+  };
+}
+function run(b: Bike, input: BikeInput, dt: number) {
+  const controller = b as unknown as {
+      gpSteer: (stick: number, frontMu: number, rearMu: number, dt: number) => number;
+    },
+    originalControl = controller.gpSteer;
+  let selected: { target: number; reserve: number; trim: number } | undefined,
+    outputAtPlant: ReturnType<typeof output> | undefined;
+  const gp = b.motoGP!,
+    originalPlant = gp.step,
+    inverse = vi.spyOn(gp, 'frontSteerFor'),
+    rear = vi.spyOn(gp, 'rearForceFor'),
+    observer = vi.spyOn(gp, 'currentLateralAcceleration'),
+    plant = vi.spyOn(gp, 'step').mockImplementation((q) => {
+      const returned = originalPlant.call(gp, q);
+      outputAtPlant = output(gp);
+      return returned;
+    }),
+    control = vi.spyOn(controller, 'gpSteer').mockImplementation((...args) => {
+      const returned = originalControl.apply(b, args);
+      selected = { target: gp.leanTarget, reserve: gp.lateralDemand, trim: gp.steerTrim };
+      return returned;
+    });
+  b.step(input, dt);
+  expect(control).toHaveBeenCalledTimes(1);
+  expect(inverse).toHaveBeenCalledTimes(1);
+  expect(rear).toHaveBeenCalledTimes(b.contactLoads ? 1 : 0);
+  expect(plant).toHaveBeenCalledTimes(1);
+  const result = {
+    inverse: inverse.mock.calls[0],
+    inverseResult: inverse.mock.results[0].value as number | null,
+    rear: rear.mock.calls[0],
+    observation: observer.mock.calls[0]?.[0],
+    plant: { ...plant.mock.calls[0][0] },
+    barRequest: control.mock.results[0].value as number,
+    target: selected!.target,
+    reserve: selected!.reserve,
+    trim: selected!.trim,
+    output: outputAtPlant!,
+    after: after(b),
+  };
+  control.mockRestore();
+  inverse.mockRestore();
+  rear.mockRestore();
+  observer.mockRestore();
+  plant.mockRestore();
+  return result;
+}
+
+describe('GP final command admission uses its native signed front interval', () => {
+  it.each(saved.cases)('matches the sealed early-phase native replay at $label', (f) => {
+    const b = bike(f),
+      result = run(b, f.input, f.dt),
+      early = f.admission.early;
+    // Exact finite-dt outcomes, not a comparison against a computed circle.
+    expect(recorded(result.plant)).toEqual(f.diagnostic.plantInput);
+    expect(recorded(result.output)).toEqual(f.diagnostic.plantOutput);
+    expect(recorded(result.after)).toEqual(f.diagnostic.after);
+    expect(result.trim).toBe(f.diagnostic.trim);
+    expect(result.barRequest).toBe(f.diagnostic.barRequest);
+    expect(result.target === f.original.target).toBe(true);
+    expect(result.reserve).toBe(f.original.reserve);
+    expect(result.observation?.speed).toBe(early.speed);
+    expect(result.observation?.frontFx === early.frontFx).toBe(true);
+    expect(result.observation?.rearFx === early.rearFx).toBe(true);
+    expect(recorded(result.inverse.slice(1, 6))).toEqual([
+      early.lean,
+      early.speed,
+      early.frontFx,
+      early.effectiveFrontLoad,
+      early.frontMu,
+    ]);
+    expect(recorded(result.rear)).toEqual([
+      early.rearLoad,
+      early.rearMu,
+      early.lean,
+      early.speed,
+      early.rearFx,
+      early.dt,
+    ]);
+    const range = result.inverse[6];
+    if ('reservedFrontForceInterval' in f.admission) {
+      expect(range).toEqual({
+        minimum: f.admission.reservedFrontForceInterval?.[0],
+        maximum: f.admission.reservedFrontForceInterval?.[1],
+      });
+    } else expect(range).toBeUndefined();
+    expect(result.plant.frontFx === f.original.plantInput.frontFx).toBe(true);
+    expect(result.plant.rearFx === f.original.plantInput.rearFx).toBe(true);
+    expect(result.plant.speed).toBe(f.original.plantInput.speed);
+    expect(Math.abs(b.steer - f.stepEntry.steer)).toBeLessThanOrEqual(b.p.steerRate * f.dt + 1e-15);
+    expect(Math.abs(b.steer)).toBeLessThanOrEqual(b.p.maxSteer);
+  });
+
+  const precursors = saved.cases.filter((f) =>
+    ['maximumRollForecastDifference', 'firstRearUnloaded'].includes(f.label),
+  );
+  it.each(precursors)('also admits the reflected recovery at $label', (f) => {
+    const b = bike(f),
+      gp = b.motoGP!;
+    for (const key of ['lean', 'leanRate', 'steer', 'riderOffset'] as const) b[key] *= -1;
+    for (const key of [
+      'lateralSpeed',
+      'yawRate',
+      'lateralAcceleration',
+      'frontFy',
+      'rearFy',
+      'frontSlipAngle',
+      'rearSlipAngle',
+      'groundSteer',
+      'steerTrim',
+      'leanTarget',
+    ] as const)
+      gp[key] *= -1;
+    const result = run(b, { ...f.input, lean: -f.input.lean, rider: -f.input.rider }, f.dt);
+    expect(result.plant.steer).toBeCloseTo(-f.diagnostic.plantInput.steer, 14);
+    expect(result.output.lateralAcceleration).toBeCloseTo(
+      -f.diagnostic.plantOutput.lateralAcceleration,
+      12,
+    );
+    expect(result.after.lean).toBeCloseTo(-f.diagnostic.after.lean, 14);
+    expect(result.after.leanRate).toBeCloseTo(-f.diagnostic.after.leanRate, 12);
+    expect(result.reserve).toBeCloseTo(f.original.reserve, 12);
+    expect(result.plant.frontFx === f.original.plantInput.frontFx).toBe(true);
+    expect(result.plant.rearFx === f.original.plantInput.rearFx).toBe(true);
+  });
+
+  it.each(saved.standalone)(
+    'retains two original standalone steps from $derivedFrom.label',
+    (s) => {
+      const f = saved.cases.find(
+          (c) => c.tick === s.derivedFrom.tick && c.substep === s.derivedFrom.substep,
+        )!,
+        b = bike(f, true);
+      for (const expected of s.original) {
+        const result = run(b, f.input, f.dt);
+        expect(result.inverse[6]).toBeUndefined();
+        expect(result.observation).toBeUndefined();
+        expect(recorded(result.plant)).toEqual(expected.plantInput);
+        expect(recorded(result.output)).toEqual(expected.plantOutput);
+        expect(recorded(result.after)).toEqual(expected.after);
+        expect(result.trim).toBe(expected.trim);
+      }
+    },
+  );
+
+  it('keeps the unloaded-front fallback unchanged on the next native step', () => {
+    const f = saved.cases.find((c) => c.label === 'firstFrontUnloaded')!,
+      b = bike(f);
+    run(b, f.input, f.dt);
+    const next = run(b, f.input, f.dt);
+    expect(next.inverse[6]).toBeUndefined();
+    expect(recorded(next.plant)).toEqual(f.nextOriginal.plantInput);
+    expect(recorded(next.output)).toEqual(f.nextOriginal.plantOutput);
+    expect(recorded(next.after)).toEqual(f.nextOriginal.after);
+  });
+
+  it.each(['missing', 'nonfinite', 'reversed', 'null inverse', 'nonfinite inverse'])(
+    'repeats only the pure inverse for a complete legacy fallback when output is %s',
+    (mode) => {
+      const f = saved.cases.find((c) => c.label === 'lastRecordedControl')!,
+        b = bike(f),
+        gp = b.motoGP!;
+      const inverse = vi
+        .spyOn(gp, 'frontSteerFor')
+        .mockImplementation((force, _lean, _speed, _fx, _load, _mu, range) => {
+          if (range && mode !== 'missing') {
+            range.minimum = mode === 'reversed' ? 100 : -100;
+            range.maximum = mode === 'nonfinite' ? Infinity : mode === 'reversed' ? -100 : 100;
+          }
+          return mode === 'null inverse'
+            ? null
+            : mode === 'nonfinite inverse'
+              ? NaN
+              : force / 100000;
+        });
+      let trimAtPlant: number | undefined;
+      const oldMeasured = gp.lateralAcceleration,
+        oldStiffness = gp.frontStiffness,
+        nativePlant = gp.step,
+        plant = vi.spyOn(gp, 'step').mockImplementation((q) => {
+          trimAtPlant = gp.steerTrim;
+          return nativePlant.call(gp, q);
+        });
+      b.step(f.input, f.dt);
+      expect(inverse).toHaveBeenCalledTimes(2);
+      expect(plant).toHaveBeenCalledTimes(1);
+      expect(trimAtPlant).toBe(f.original.trim);
+      const lateral = f.originalController.lateral,
+        v = Math.max(f.bike.speed, 3),
+        rear = f.admission.heldRearPreview!,
+        legacyForce =
+          b.mass * lateral -
+          rear -
+          (GP_ASSIST.yawDamping * gp.geometry.yawInertia * (f.gp.yawRate - lateral / v)) /
+            gp.geometry.frontArm,
+        fallback =
+          Math.atan((b.p.wheelbase * lateral) / (v * v)) +
+          clamp(
+            (GP_ASSIST.feedback * b.mass * (lateral - oldMeasured)) / Math.max(4000, oldStiffness),
+            -0.06,
+            0.06,
+          ),
+        ground = (mode === 'null inverse' ? fallback : legacyForce / 100000) + f.original.trim,
+        requested = clamp(gpBarSteer(ground, f.bike.lean), -b.p.maxSteer, b.p.maxSteer);
+      expect(inverse.mock.calls[1][0]).toBe(legacyForce);
+      expect(inverse.mock.calls[1][6]).toBeUndefined();
+      expect(inverse.mock.calls[0][0]).not.toBe(legacyForce);
+      if (mode === 'nonfinite inverse') {
+        // Preserve the existing prescribed nonfinite-return semantics;
+        // this change does not introduce an unrelated sanitization policy.
+        expect(Number.isNaN(b.steer)).toBe(true);
+      } else
+        expect(b.steer).toBe(
+          f.stepEntry.steer +
+            clamp(requested - f.stepEntry.steer, -b.p.steerRate * f.dt, b.p.steerRate * f.dt),
+        );
+    },
+  );
+});
+
+describe('Native front inverse exposes only its own invocation range', () => {
+  it.each([-0.6, 0.6].flatMap((lean) => [-1400, 0, 900].map((fx) => ({ lean, fx }))))(
+    'retains signed combined-slip roots and query purity at lean $lean, Fx $fx',
+    ({ lean, fx }) => {
+      const f = saved.cases[0],
+        queried = chassis(f),
+        control = chassis(f),
+        range: GPFrontForceRange = { minimum: 99999, maximum: -99999 },
+        before = physical(queried);
+      for (const force of [-1e6, -400, 0, 400, 1e6]) {
+        const withRange = queried.frontSteerFor(force, lean, 30, fx, 1400, 1.5, range),
+          withoutRange = control.frontSteerFor(force, lean, 30, fx, 1400, 1.5),
+          samples = (queried as unknown as { inverseForces: Float64Array }).inverseForces,
+          neutral = samples[8];
+        expect(withRange).toBe(withoutRange);
+        expect(range.minimum).toBe(neutral + 0.97 * (Math.min(...samples) - neutral));
+        expect(range.maximum).toBe(neutral + 0.97 * (Math.max(...samples) - neutral));
+        expect(Number.isFinite(range.minimum)).toBe(true);
+        expect(Number.isFinite(range.maximum)).toBe(true);
+        // Raw force and the same invocation's bounded force have the same
+        // native root; output metadata cannot create extra steering authority.
+        expect(
+          queried.frontSteerFor(
+            clamp(force, range.minimum, range.maximum),
+            lean,
+            30,
+            fx,
+            1400,
+            1.5,
+          ),
+        ).toBe(withRange);
+      }
+      expect(physical(queried)).toEqual(before);
+      expect(physical(control)).toEqual(before);
+      const q: MotoGPContactStep = {
+        ...f.diagnostic.plantInput,
+        lean,
+        speed: 30,
+        frontFx: fx,
+        frontLoad: 1400,
+        frontMu: 1.5,
+      };
+      queried.step(q);
+      control.step(q);
+      expect(physical(queried)).toEqual(physical(control));
+      expect(output(queried)).toEqual(output(control));
+    },
+  );
+
+  it.each([
+    { load: 0, mu: 1.5, speed: 30 },
+    { load: 1, mu: 1.5, speed: 30 },
+    { load: 1400, mu: 0, speed: 30 },
+    { load: 1400, mu: 1.5, speed: 2.49 },
+  ])(
+    'clears a previous output without front availability: $load N, mu $mu, $speed m/s',
+    ({ load, mu, speed }) => {
+      const gp = chassis(saved.cases[0]),
+        range = { minimum: NaN, maximum: NaN };
+      expect(gp.frontSteerFor(500, 0.4, 30, -300, 1400, 1.5, range)).not.toBeNull();
+      expect(Number.isFinite(range.minimum)).toBe(true);
+      expect(gp.frontSteerFor(500, 0.4, speed, -300, load, mu, range)).toBeNull();
+      expect(Number.isNaN(range.minimum)).toBe(true);
+      expect(Number.isNaN(range.maximum)).toBe(true);
+    },
+  );
+
+  it.each([NaN, Infinity])(
+    'does not advertise a range after a nonfinite inverse input %s',
+    (lean) => {
+      const gp = chassis(saved.cases[0]),
+        range = { minimum: -123, maximum: 456 };
+      gp.frontSteerFor(500, lean, 30, -300, 1400, 1.5, range);
+      expect(Number.isNaN(range.minimum)).toBe(true);
+      expect(Number.isNaN(range.maximum)).toBe(true);
+    },
+  );
+});
