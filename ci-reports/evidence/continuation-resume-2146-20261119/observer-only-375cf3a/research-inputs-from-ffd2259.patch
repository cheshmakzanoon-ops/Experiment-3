diff --git a/tests/gp-current-observer.test.ts b/tests/gp-current-observer.test.ts
new file mode 100644
index 0000000..4a826cd
--- /dev/null
+++ b/tests/gp-current-observer.test.ts
@@ -0,0 +1,313 @@
+import { describe, expect, it, vi } from 'vitest';
+import { GP_R1 } from '../src/simulation/bike-definitions.ts';
+import { BikeVehicle } from '../src/simulation/bike-vehicle.ts';
+import { BIKE, Bike, NOVICE } from '../src/simulation/bike.ts';
+import { DEFAULT_SETUP } from '../src/simulation/config.ts';
+import {
+  gpGroundSteer,
+  gpCamberFriction,
+  gpHangOffAngle,
+  gpRollInertia,
+  gpSpinPerSpeed,
+  MOTOGP_SLICK,
+  MotoGPChassis,
+  type MotoGPContactStep,
+} from '../src/simulation/motogp-physics.ts';
+import recorded from './fixtures/gp-ardennes-load-phase.json';
+import { prepareSlip, slipState } from '../src/simulation/tyre-force.ts';
+
+const scratch = new Set(['force', 'inverseFront', 'previewFront', 'previewRear', 'inverseForces']);
+function physical(gp: MotoGPChassis) {
+  return JSON.parse(
+    JSON.stringify(
+      Object.fromEntries(
+        Object.entries(gp).filter(
+          ([key, value]) => !scratch.has(key) && typeof value !== 'function',
+        ),
+      ),
+    ),
+  );
+}
+function clone(gp: MotoGPChassis) {
+  return Object.assign(new MotoGPChassis(gp.geometry), structuredClone(gp));
+}
+function fixture(sign = 1) {
+  const gp = new MotoGPChassis(recorded.geometry),
+    q: MotoGPContactStep = {
+      ...recorded.q,
+      lean: sign * recorded.q.lean,
+      steer: sign * recorded.beforeBikeStep.bar,
+    };
+  Object.assign(gp, recorded.state);
+  for (const key of [
+    'lateralSpeed',
+    'yawRate',
+    'lateralAcceleration',
+    'frontFy',
+    'rearFy',
+  ] as const)
+    gp[key] *= sign;
+  return { gp, q };
+}
+
+/** Exercise the REAL plant's preparation and force projection while its
+ * exponential relaxation increment is exactly zero. This positive timestep
+ * is valid for the native solver; no contact or math function is mocked.
+ * The normal120/240Hz step is tested separately and need not give this force. */
+function nativePreparation(gp: MotoGPChassis, q: MotoGPContactStep) {
+  const dt = 1e-20,
+    plant = clone(gp);
+  expect(1 - Math.exp((-dt * Math.max(q.speed, 3)) / MOTOGP_SLICK.relaxationLength)).toBe(0);
+  plant.step({ ...q, dt });
+  return plant;
+}
+
+describe('GP current strain observation has no contact-time advance', () => {
+  it.each([-1, 1].flatMap((sign) => recorded.variants.map((v) => ({ sign, ...v }))))(
+    'matches native zero-time preparation for $name, sign $sign',
+    ({ sign, q: saved }) => {
+      const { gp } = fixture(sign),
+        q = { ...saved, lean: sign * saved.lean, steer: sign * saved.steer },
+        before = physical(gp),
+        observed = gp.currentLateralAcceleration(q),
+        prepared = nativePreparation(gp, q),
+        advanced = clone(gp);
+      expect(physical(gp)).toEqual(before);
+      expect(observed).toBe(prepared.lateralAcceleration);
+      advanced.step(q);
+      // The previous full-step predictor answers a different question: it
+      // relaxes the force toward this held bar before choosing the new bar.
+      expect(Math.abs(observed - advanced.lateralAcceleration)).toBeGreaterThan(0.01);
+    },
+  );
+
+  const transitions = [
+    { name: 'reload', front: 1.5, rear: 1.5, contact: 1, frontFx: 0, rearFx: -180, mu: 1 },
+    {
+      name: 'unequal unload',
+      front: 0.4,
+      rear: 1.2,
+      contact: 0.4,
+      frontFx: -100,
+      rearFx: 400,
+      mu: 1,
+    },
+    { name: 'front lift', front: 0, rear: 1, contact: 0, frontFx: 0, rearFx: -180, mu: 1 },
+    { name: 'rear lift', front: 1, rear: 0, contact: 1, frontFx: -300, rearFx: 0, mu: 1 },
+    {
+      name: 'low grip braking',
+      front: 1,
+      rear: 1,
+      contact: 1,
+      frontFx: -350,
+      rearFx: -300,
+      mu: 0.25,
+    },
+    { name: 'brake release', front: 1, rear: 1, contact: 1, frontFx: 0, rearFx: 0, mu: 1 },
+  ];
+  it.each([-1, 1].flatMap((sign) => transitions.map((v) => ({ sign, ...v }))))(
+    'observes native prepared strain for $name, sign $sign',
+    ({ sign, front, rear, contact, frontFx, rearFx, mu }) => {
+      const { gp, q } = fixture(sign);
+      Object.assign(q, {
+        frontLoad: q.frontLoad * front,
+        rearLoad: q.rearLoad * rear,
+        frontMu: q.frontMu * mu,
+        rearMu: q.rearMu * mu,
+        frontContact: contact,
+        frontFx,
+        rearFx,
+      });
+      const before = physical(gp),
+        observed = gp.currentLateralAcceleration(q),
+        plant = nativePreparation(gp, q);
+      expect(observed).toBe(plant.lateralAcceleration);
+      expect(gp.currentLateralAcceleration(q)).toBe(observed);
+      expect(physical(gp)).toEqual(before);
+    },
+  );
+
+  it.each([-1, 1])(
+    'pairs current reaction and current strain in the native roll equation, sign %s',
+    (sign) => {
+      const { gp } = fixture(sign),
+        saved = recorded.variants.find(
+          (v) => v.name === 'exact-proportional-current-total-held-bar',
+        )!,
+        q = { ...saved.q, lean: sign * saved.q.lean, steer: sign * saved.q.steer },
+        reaction = (q.frontLoad + q.rearLoad) / q.mass,
+        psi =
+          q.lean + gpHangOffAngle(sign * recorded.beforeBikeStep.riderOffset, recorded.cgHeight),
+        inertia = gpRollInertia(gp.geometry, q.mass, recorded.cgHeight),
+        gyro =
+          gpSpinPerSpeed(gp.geometry) *
+          recorded.beforeBikeStep.speed *
+          gp.yawRate *
+          Math.cos(q.lean),
+        rolling = (lateral: number) =>
+          (q.mass * recorded.cgHeight * (reaction * Math.sin(psi) - lateral * Math.cos(psi)) -
+            gyro) /
+          inertia,
+        old = rolling(gp.lateralAcceleration),
+        observed = rolling(gp.currentLateralAcceleration(q)),
+        native = rolling(nativePreparation(gp, q).lateralAcceleration);
+      expect(observed).toBe(native);
+      expect(Math.abs(old)).toBeGreaterThan(0.68);
+      expect(Math.abs(observed)).toBeLessThan(0.08);
+      expect(Math.abs(old - observed)).toBeGreaterThan(0.6);
+    },
+  );
+
+  it('is independent of120/240Hz step duration and differs from both full future steps', () => {
+    const { gp, q } = fixture(),
+      observed = gp.currentLateralAcceleration(q),
+      future: number[] = [];
+    for (const dt of [1 / 120, 1 / 240]) {
+      const request = { ...q, dt },
+        plant = clone(gp);
+      expect(gp.currentLateralAcceleration(request)).toBe(observed);
+      plant.step(request);
+      future.push(plant.lateralAcceleration);
+      expect(Math.abs(plant.lateralAcceleration - observed)).toBeGreaterThan(0.01);
+    }
+    expect(future[0]).not.toBe(future[1]);
+  });
+
+  it('preserves the exact measured force when contact preparation and bar pose have not changed', () => {
+    const { gp, q } = fixture();
+    gp.step(q);
+    const actual = gp.lateralAcceleration;
+    expect(gp.currentLateralAcceleration(q)).toBe(actual);
+    const ground = gpGroundSteer(q.steer, q.lean);
+    expect(actual).toBe(
+      (gp.frontFy * Math.cos(ground) + q.frontFx * Math.sin(ground) + gp.rearFy) / q.mass,
+    );
+  });
+
+  it('leaves all physical history and the next full step unchanged by repeated mixed queries', () => {
+    const { gp, q } = fixture(),
+      untouched = clone(gp),
+      before = physical(gp),
+      observed = gp.currentLateralAcceleration(q);
+    for (let i = 0; i < 8; i++) {
+      gp.frontSteerFor(400, q.lean, q.speed, q.frontFx, q.frontLoad, q.frontMu);
+      gp.rearForceFor(q.rearLoad, q.rearMu, q.lean, q.speed, q.rearFx, q.dt);
+      expect(gp.currentLateralAcceleration(q)).toBe(observed);
+      expect(physical(gp)).toEqual(before);
+    }
+    gp.step(q);
+    untouched.step(q);
+    expect(physical(gp)).toEqual(physical(untouched));
+  });
+
+  it('keeps force and heat zero through flight and a fresh zero-slip landing', () => {
+    const { gp, q } = fixture();
+    gp.reset(q.speed);
+    q.lean = q.steer = q.frontFx = q.rearFx = 0;
+    for (const load of [500, 1900, 0, 1900, 1200]) {
+      q.frontLoad = q.rearLoad = load;
+      q.frontContact = load ? 1 : 0;
+      expect(gp.currentLateralAcceleration(q)).toBe(0);
+      gp.step(q);
+      expect(gp.lateralAcceleration).toBe(0);
+      expect(gp.frontSlidingPower).toBe(0);
+      expect(gp.rearSlidingPower).toBe(0);
+    }
+  });
+
+  it.each([-1, 1])(
+    'does not transmit obsolete front Fx through a lost contact, bar sign %s',
+    (sign) => {
+      const { gp, q } = fixture(sign);
+      q.frontLoad = q.rearLoad = 0;
+      q.frontContact = 0;
+      q.frontFx = -1500;
+      q.rearFx = 1800;
+      q.steer = sign * 0.2;
+      const before = physical(gp);
+      expect(Math.abs(q.frontFx * Math.sin(gpGroundSteer(q.steer, q.lean)))).toBeGreaterThan(300);
+      expect(gp.currentLateralAcceleration(q)).toBe(0);
+      expect(physical(gp)).toEqual(before);
+      // A valid physical plant receives the zero force pair after allocation;
+      // the observer must reach that force-free result before allocation too.
+      expect(nativePreparation(gp, { ...q, frontFx: 0, rearFx: 0 }).lateralAcceleration).toBe(0);
+    },
+  );
+
+  it.each([-1, 1])(
+    'projects prior braking only inside a newly smaller front circle, sign %s',
+    (sign) => {
+      const { gp, q } = fixture(sign);
+      q.frontLoad = 150;
+      q.frontMu = 0.4;
+      q.frontContact = 0.5;
+      q.frontFx = -1500;
+      q.rearLoad = 0;
+      q.rearFx = 0;
+      const prepared = slipState();
+      prepareSlip(
+        MOTOGP_SLICK,
+        q.frontLoad * q.frontContact,
+        q.frontMu * gpCamberFriction(q.lean),
+        1,
+        1,
+        1,
+        prepared,
+      );
+      const bound = prepared.dy,
+        before = physical(gp),
+        observed = gp.currentLateralAcceleration(q),
+        ground = gpGroundSteer(q.steer, q.lean),
+        feasible = { ...q, frontFx: -bound };
+      expect(observed).toBe((-bound * Math.sin(ground)) / q.mass);
+      expect(observed).toBe(nativePreparation(gp, feasible).lateralAcceleration);
+      expect(Math.abs(observed * q.mass)).toBeLessThanOrEqual(bound);
+      expect(physical(gp)).toEqual(before);
+      expect(q.frontFx).toBe(-1500);
+    },
+  );
+
+  it('observes known pedal history before the original single control/contact step', () => {
+    const bike = new BikeVehicle(0, 'medium', DEFAULT_SETUP, 'sport', GP_R1).dynamics,
+      gp = bike.motoGP!,
+      dt = 1 / 240,
+      oldSpeed = (bike.speed = 30),
+      oldBar = (bike.steer = -0.1),
+      priorFront = (bike.frontBrakeForce = 700),
+      priorRear = (bike.driveForce = 1500);
+    gp.reset(oldSpeed);
+    bike.contactLoads = { front: 30, rear: 2400 };
+    const observation = vi.spyOn(gp, 'currentLateralAcceleration'),
+      inverse = vi.spyOn(gp, 'frontSteerFor').mockReturnValue(0.6),
+      plant = vi.spyOn(gp, 'step');
+    bike.step({ lean: 0.3, rider: 0, throttle: 0, frontBrake: 0.5, rearBrake: 0, drive: 0 }, dt);
+    expect(observation).toHaveBeenCalledTimes(1);
+    expect(plant).toHaveBeenCalledTimes(1);
+    const p = observation.mock.calls[0][0],
+      q = plant.mock.calls[0][0];
+    expect('dt' in p).toBe(false);
+    expect(p.speed).toBe(oldSpeed);
+    expect(p.steer).toBe(oldBar);
+    expect(p.frontFx).toBe(-priorFront);
+    expect(p.rearFx).toBe(priorRear);
+    expect(p.frontLoad).toBe(q.frontLoad);
+    expect(p.rearLoad).toBe(q.rearLoad);
+    expect(p.frontContact).toBe(q.frontContact);
+    expect(q.frontFx).not.toBe(p.frontFx);
+    expect(q.rearFx).not.toBe(p.rearFx);
+    // This decomposition deliberately retains the original early inverse.
+    // Current-force phase resolution is a separate, unaccepted candidate.
+    expect(inverse.mock.calls[0][3]).toBe(p.frontFx);
+    expect(q.steer - oldBar).toBeCloseTo(bike.p.steerRate * dt, 12);
+  });
+
+  it.each(['standalone', 'flight'])('does not invoke the road observation for %s', (mode) => {
+    const bike = new Bike(NOVICE, BIKE);
+    bike.speed = 30;
+    bike.enableMotoGPPhysics(recorded.geometry);
+    if (mode === 'flight') bike.contactLoads = { front: 0, rear: 0 };
+    const observe = vi.spyOn(bike.motoGP!, 'currentLateralAcceleration');
+    bike.step({ lean: 0.3, rider: 0, throttle: 0, frontBrake: 0, rearBrake: 0, drive: 0 }, 1 / 240);
+    expect(observe).not.toHaveBeenCalled();
+  });
+});
