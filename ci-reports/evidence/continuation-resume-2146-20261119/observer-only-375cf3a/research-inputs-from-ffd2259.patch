+++ b/tests/gp-passing-runway.test.ts
@@ -0,0 +1,91 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { ENVELOPE_STEP } from '../src/simulation/ai.ts';
+import { BikeAIDriver, gpApproachRunway } from '../src/simulation/bike-ai.ts';
+import type { BikeVehicle } from '../src/simulation/bike-vehicle.ts';
+import { DEFAULT_OPTIONS } from '../src/simulation/config.ts';
+import * as braking from '../src/simulation/motorcycle-braking-plan.ts';
+import { racingLineFor } from '../src/simulation/racing-line.ts';
+import type { RaceDirector } from '../src/simulation/race.ts';
+import type { Track } from '../src/simulation/track.ts';
+import { Simulation } from '../src/simulation/world.ts';
+import recorded from './fixtures/gp-runway-profile.json';
+
+afterEach(() => vi.restoreAllMocks());
+
+class RunwayProbe extends BikeAIDriver {
+  plan(track: Track, race: RaceDirector) {
+    return this.limitSpeed(100, track, race);
+  }
+  paceFor(track: Track) {
+    return this.passPace(track);
+  }
+}
+
+describe('GP passing runway observes the braking profile', () => {
+  it('ends passing room before a descending segment, including braking already underway', () => {
+    expect(gpApproachRunway([70, 60, 50, 55], 4)).toBe(0);
+    // Acceleration, a level section, then a real braking descent. The end of
+    // the level section is the onset; the later minimum is not usable runway.
+    expect(gpApproachRunway([50, 60, 70, 70, 60, 50, 55], 7)).toBe(3 * ENVELOPE_STEP);
+  });
+
+  it('bounds an accelerating or level profile to the observed extent', () => {
+    expect(gpApproachRunway([50, 60, 70, 80], 4)).toBe(3 * ENVELOPE_STEP);
+    expect(gpApproachRunway([80, 80, 80, 80], 4)).toBe(3 * ENVELOPE_STEP);
+    const reused = new Float64Array([50, 60, 70, NaN, 0]);
+    expect(gpApproachRunway(reused, 3)).toBe(2 * ENVELOPE_STEP);
+    expect(gpApproachRunway(reused, 2)).toBe(ENVELOPE_STEP);
+  });
+
+  it('ignores floating point roundoff at a plateau without hiding a physical descent', () => {
+    const ulp = Number.EPSILON * 80;
+    expect(gpApproachRunway([80, 80 - ulp, 80, 80], 4)).toBe(3 * ENVELOPE_STEP);
+    expect(gpApproachRunway([80, 80 - ulp, 80, 79.99], 4)).toBe(2 * ENVELOPE_STEP);
+  });
+
+  it('does not promise passing distance from missing or invalid observed samples', () => {
+    for (const count of [0, 1, 1.5, 4, NaN, Infinity])
+      expect(gpApproachRunway([50, 60, 70], count)).toBe(0);
+    for (const invalid of [NaN, Infinity, -1])
+      expect(gpApproachRunway([50, invalid, 70], 3)).toBe(0);
+  });
+
+  it('keeps the same native profile runway when measured speed crosses its old minimum threshold', () => {
+    const sim = new Simulation({
+      ...DEFAULT_OPTIONS,
+      circuit: 'vellamar',
+      mode: 'practice',
+      ruleset: 'gp-motorcycle',
+      opponents: 0,
+      vehicles: ['gpr1'],
+      seed: 3303,
+    });
+    const bike = sim.cars[0] as BikeVehicle;
+    bike.place(sim.track, recorded.station, racingLineFor(sim.track).offsetAt(recorded.station));
+    bike.dynamics.grip = bike.dynamics.frontGrip = bike.dynamics.rearGrip = 1;
+    const driver = new RunwayProbe(bike, 0.92, 3303);
+    const counts: number[] = [];
+    // Freeze only the solved profile to the recorded native result. All
+    // production limitSpeed/passPace wiring remains active. This isolates
+    // the measured-speed threshold from geometry and tyre-plan changes.
+    vi.spyOn(braking, 'motorcycleApproachProfile').mockImplementation(
+      (_curvatures, _corners, _grip, _aero, _env, count, profile) => {
+        expect(count).toBeLessThanOrEqual(recorded.validCount);
+        counts.push(count);
+        profile.set(recorded.profile);
+        return recorded.profile[0];
+      },
+    );
+    const runways: number[] = [];
+    for (const speed of recorded.measuredSpeeds) {
+      bike.dynamics.speed = bike.speed = speed;
+      bike.aiOffset = racingLineFor(sim.track).offsetAt(
+        bike.s + Math.min(46, Math.max(8, 6 + speed * 0.48)),
+      );
+      expect(driver.plan(sim.track, sim.race)).toBe(recorded.profile[0]);
+      runways.push(driver.paceFor(sim.track)!.runway);
+    }
+    expect(counts[0]).toBe(counts[1]);
+    expect(runways).toEqual([0, 0]);
+  });
+});
diff --git a/tests/gp-steering-throttle-ownership.test.ts b/tests/gp-steering-throttle-ownership.test.ts
new file mode 100644
index 0000000..36ce2d4
--- /dev/null
+++ b/tests/gp-steering-throttle-ownership.test.ts
@@ -0,0 +1,76 @@
+import { describe, expect, it } from 'vitest';
+import { G } from '../src/core/math.ts';
+import { BikeAIDriver } from '../src/simulation/bike-ai.ts';
+import { GP_R1 } from '../src/simulation/bike-definitions.ts';
+import { BikeVehicle } from '../src/simulation/bike-vehicle.ts';
+import { DEFAULT_SETUP } from '../src/simulation/config.ts';
+import { Track } from '../src/simulation/track.ts';
+
+class DemandDriver extends BikeAIDriver {
+  constructor(
+    bike: BikeVehicle,
+    private readonly pathAcceleration: number,
+    private readonly correctionAcceleration: number,
+  ) {
+    super(bike);
+  }
+  protected override steeringLineOffset() {
+    return 0;
+  }
+  protected override steeringLineCurvature() {
+    return this.pathAcceleration / this.bike.dynamics.speed ** 2;
+  }
+  protected override pathCorrection() {
+    return this.correctionAcceleration / this.bike.dynamics.speed ** 2;
+  }
+}
+
+/** Exercise the actual intent conversion followed by the actual throttle
+ * budget, with controlled path/feedback inputs instead of duplicating either
+ * controller formula. The final physical contact controls still run in Bike. */
+function plannedThrottle(track: Track, path: number, correction: number, support = 1) {
+  const bike = new BikeVehicle(0, 'medium', DEFAULT_SETUP, 'sport', GP_R1);
+  bike.place(track, 120, 0);
+  const d = bike.dynamics;
+  d.speed = 30;
+  d.frontLoad = (support * d.mass * G * d.p.cgToRear) / d.p.wheelbase;
+  d.rearLoad = (support * d.mass * G * d.p.cgToFront) / d.p.wheelbase;
+  d.contactLoads = { front: d.frontLoad, rear: d.rearLoad };
+  bike.gear = 1;
+  bike.rpm = 12000;
+  bike.aiOffset = 0;
+  const driver = new DemandDriver(bike, path, correction) as unknown as {
+    steerIntent(track: Track, steer: number): number;
+    steeringThrottle(): number;
+  };
+  bike.input.steer = driver.steerIntent(track, 0);
+  return { intent: bike.input.steer, throttle: driver.steeringThrottle() };
+}
+
+describe('GP AI charges the total requested lateral acceleration once', () => {
+  const track = new Track('clear', true);
+
+  it.each([-1, 1])(
+    'keeps the same %s turn budget when path correction agrees with or opposes its curve',
+    (sign) => {
+      const total = sign * 6;
+      const plain = plannedThrottle(track, total, 0);
+      expect(plain.throttle).toBeGreaterThan(0);
+      expect(plain.throttle).toBeLessThan(1);
+      for (const correction of [sign * 2, -sign * 2]) {
+        const result = plannedThrottle(track, total - correction, correction);
+        expect(result.intent).toBeCloseTo(plain.intent, 12);
+        expect(result.throttle).toBeCloseTo(plain.throttle, 12);
+      }
+    },
+  );
+
+  it('inverts intent with the same normal reaction used to encode its path demand', () => {
+    const nominal = plannedThrottle(track, 6, 0);
+    for (const support of [0.7, 1.3]) {
+      const result = plannedThrottle(track, 6, 0, support);
+      expect(result.intent).not.toBeCloseTo(nominal.intent, 3);
+      expect(result.throttle).toBeCloseTo(nominal.throttle, 12);
+    }
+  });
+});
