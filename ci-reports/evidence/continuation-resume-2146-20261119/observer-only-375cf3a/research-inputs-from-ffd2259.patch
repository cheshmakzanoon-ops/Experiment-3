+/** Passing room ends at the first descending segment of the solved speed
+ * profile, even if the rider is currently slower than that profile. Comparing
+ * future limits with measured speed made the same braking feature alternate
+ * between a short runway and an unobserved straight as the rider accelerated.
+ * The result uses centreline metres, like the traffic planner. A monotone
+ * profile proves only its valid sampled extent, never the unused buffer tail.
+ * Roundoff-sized differences between equal limits are not braking events. */
+export function gpApproachRunway(profile: ArrayLike<number>, count: number) {
+  if (!Number.isInteger(count) || count < 2 || count > profile.length) return 0;
+  let previous = profile[0];
+  if (!Number.isFinite(previous) || previous < 0) return 0;
+  for (let i = 1; i < count; i++) {
+    const next = profile[i];
+    if (!Number.isFinite(next) || next < 0) return 0;
+    const roundoff = 32 * Number.EPSILON * Math.max(1, previous, next);
+    if (next < previous - roundoff) return (i - 1) * ENVELOPE_STEP;
+    previous = next;
+  }
+  return (count - 1) * ENVELOPE_STEP;
