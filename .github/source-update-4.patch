+import { describe, it, expect } from 'vitest';
+import {
+  FLAG,
+  MARSHAL,
+  MarshalControl,
+  flagLabel,
+  pitSpeedZone,
+} from '../src/simulation/marshal.ts';
+import { Track } from '../src/simulation/track.ts';
+import { Vehicle } from '../src/simulation/vehicle.ts';
+import { Simulation } from '../src/simulation/world.ts';
+import { DEFAULT_OPTIONS } from '../src/simulation/config.ts';
+import { F, H, carBase } from '../src/simulation/protocol.ts';
+import { TrafficPlanner, personality } from '../src/simulation/traffic.ts';
+
+function field() {
+  const track = new Track();
+  const cars = [new Vehicle(0), new Vehicle(1), new Vehicle(2)];
+  cars.forEach((c, id) => {
+    c.place(track, 700 + id * 100);
+    c.speed = 20;
+  });
+  const progress = cars.map((c) => ({ distance: c.s }));
+  const penalties: { car: number; seconds: number; code: string }[] = [];
+  const control = new MarshalControl(track.length, 3, (car, seconds, code) => {
+    penalties.push({ car, seconds, code });
+    control.recordPenalty(car, seconds, code, 20);
+  });
+  return { track, cars, progress, control, penalties };
+}
+describe('spatial marshal flags', () => {
+  it('flags only the approaching zone and expires a cleared collision', () => {
+    const { cars, progress, control } = field();
+    cars[1].s = 800;
+    cars[1].impact = 0.7;
+    cars[0].s = 650;
+    cars[2].s = 1200;
+    control.update(0.01, 10, cars, progress);
+    expect(control.flags[0]).toBe(FLAG.YELLOW);
+    expect(control.flags[2]).toBe(FLAG.GREEN);
+    expect(control.targetSpeed(0, 5)).toBe(MARSHAL.yellowSpeed);
+    cars[1].impact = 0;
+    for (let i = 0; i < 302; i++) control.update(0.01, 10.01 + i * 0.01, cars, progress);
+    expect(control.flags[0]).toBe(FLAG.GREEN);
+    expect(control.hasIncident).toBe(false);
+    expect(control.events.some((event) => event.kind === 'clear')).toBe(true);
+  });
+  it('wraps caution around the lap seam without slowing cars elsewhere', () => {
+    const { cars, track, progress, control } = field();
+    cars[1].s = 40;
+    cars[1].impact = 0.5;
+    cars[0].s = track.length - 80;
+    cars[2].s = 400;
+    control.update(0.01, 10, cars, progress);
+    expect(control.flags[0]).toBe(FLAG.YELLOW);
+    expect(control.flags[2]).toBe(FLAG.GREEN);
+  });
+  it('gives a braking preview before the yellow entry, not a speed teleport', () => {
+    const { cars, progress, control } = field();
+    cars[0].s = 550;
+    cars[0].speed = 70;
+    cars[1].s = 800;
+    cars[1].impact = 1;
+    const before = { ...cars[0].body.position };
+    control.update(0.01, 10, cars, progress);
+    expect(control.flags[0]).toBe(FLAG.GREEN);
+    expect(control.zoneDistance[0]).toBeCloseTo(70);
+    expect(control.targetSpeed(0, 5)).toBeCloseTo(Math.sqrt(625 + 700));
+    expect(cars[0].speed).toBe(70);
+    expect(cars[0].body.position).toMatchObject(before);
+  });
+  it('distinguishes prolonged on-track obstructions from grid, pit and runoff stops', () => {
+    const { cars, progress, control } = field();
+    cars[1].speed = 0;
+    for (let i = 0; i < 200; i++) control.update(0.01, i * 0.01, cars, progress);
+    expect(control.hasIncident).toBe(false);
+    cars[1].inPit = true;
+    for (let i = 0; i < 250; i++) control.update(0.01, 10 + i * 0.01, cars, progress);
+    expect(control.hasIncident).toBe(false);
+    cars[1].inPit = false;
+    cars[1].lateral = 30;
+    for (let i = 0; i < 250; i++) control.update(0.01, 13 + i * 0.01, cars, progress);
+    expect(control.hasIncident).toBe(false);
+    cars[1].lateral = 0;
+    for (let i = 0; i < 250; i++) control.update(0.01, 16 + i * 0.01, cars, progress);
+    expect(control.flags[0]).toBe(FLAG.DOUBLE_YELLOW);
+    expect(control.targetSpeed(0, 5)).toBe(12);
+  });
+  it('issues blue flags only to a lapped car with a faster leader closing', () => {
+    const { cars, track, progress, control } = field();
+    cars[1].s = 680;
+    cars[1].speed = 35;
+    progress[1].distance = progress[0].distance + track.length - 20;
+    control.update(0.01, 10, cars, progress);
+    expect(control.flags[0]).toBe(FLAG.BLUE);
+    expect(control.blueCar[0]).toBe(1);
+    cars[1].s = 750;
+    control.update(0.01, 10.01, cars, progress);
+    expect(control.flags[0]).toBe(FLAG.GREEN);
+    expect(control.blueCar[0]).toBe(-1);
+  });
+  it('records the changed flag, not an event on every physics tick', () => {
+    const { cars, progress, control } = field();
+    cars[1].retired = true;
+    control.update(0.01, 10, cars, progress);
+    const count = control.events.length;
+    for (let i = 0; i < 100; i++) control.update(0.01, 10 + i * 0.01, cars, progress);
+    expect(control.events.length).toBe(count);
+    for (let i = 0; i < 300; i++) control.recordPenalty(0, 5, 'FIXTURE', i);
+    expect(control.events.length).toBe(MARSHAL.maximumEvents);
+    expect(control.events.at(-1)!.sequence).toBe(control.sequence);
+  });
+});
+describe('race-control enforcement', () => {
+  it('gives a legal return-position interval and then penalizes an illegal pass once', () => {
+    const { cars, progress, control, penalties } = field();
+    cars[2].s = 810;
+    cars[2].impact = 0.8;
+    cars[0].s = 700;
+    cars[1].s = 710;
+    control.update(0.01, 10, cars, progress);
+    cars[0].s = 720;
+    control.update(0.01, 10.1, cars, progress);
+    expect(penalties).toEqual([]);
+    control.update(0.01, 12.2, cars, progress);
+    expect(penalties).toEqual([{ car: 0, seconds: 5, code: 'OVERTAKE_UNDER_YELLOW' }]);
+    control.update(0.01, 12.3, cars, progress);
+    expect(penalties).toHaveLength(1);
+  });
+  it('does not penalize giving the place back or safely passing a stationary hazard', () => {
+    const { cars, progress, control, penalties } = field();
+    cars[2].s = 810;
+    cars[2].retired = true;
+    cars[0].s = 700;
+    cars[1].s = 710;
+    control.update(0.01, 10, cars, progress);
+    cars[0].s = 720;
+    control.update(0.01, 10.1, cars, progress);
+    cars[0].s = 700;
+    control.update(0.01, 10.2, cars, progress);
+    control.update(0.01, 13, cars, progress);
+    expect(penalties).toEqual([]);
+    cars[1].speed = 0;
+    cars[0].s = 720;
+    control.update(0.01, 13.1, cars, progress);
+    control.update(0.01, 16, cars, progress);
+    expect(penalties).toEqual([]);
+  });
+  it('applies pit speeding equally to opponents and the player, once per visit', () => {
+    const { cars, progress, control, penalties } = field();
+    cars[1].inPit = true;
+    cars[1].s = 90;
+    cars[1].speed = 26;
+    for (let i = 0; i < 300; i++) control.update(0.01, 10 + i * 0.01, cars, progress);
+    expect(penalties).toEqual([{ car: 1, seconds: 5, code: 'PIT_SPEEDING' }]);
+    cars[1].inPit = false;
+    control.update(0.01, 14, cars, progress);
+    cars[1].inPit = true;
+    for (let i = 0; i < 120; i++) control.update(0.01, 15 + i * 0.01, cars, progress);
+    expect(penalties).toHaveLength(2);
+  });
+  it('does not flag transient speed overshoot or normal pit exit acceleration', () => {
+    const { cars, progress, control, penalties } = field();
+    cars[1].inPit = true;
+    cars[1].s = 100;
+    cars[1].speed = 26;
+    control.update(0.5, 10, cars, progress);
+    cars[1].speed = 20;
+    control.update(0.1, 10.1, cars, progress);
+    cars[1].s = 300;
+    cars[1].speed = 30;
+    for (let i = 0; i < 30; i++) control.update(0.1, 11 + i * 0.1, cars, progress);
+    expect(penalties).toEqual([]);
+    expect(pitSpeedZone(300, 1000)).toBe(false);
+    expect(pitSpeedZone(950, 1000)).toBe(true);
+  });
+  it('limits AI targets under local caution without altering physics state', () => {
+    const sim = new Simulation({ ...DEFAULT_OPTIONS, opponents: 2, mode: 'practice' });
+    sim.race.time += 10;
+    const [driver, hazard, distant] = sim.cars;
+    driver.place(sim.track, 700);
+    driver.speed = 40;
+    hazard.place(sim.track, 800);
+    hazard.impact = 0.9;
+    hazard.speed = 20;
+    distant.place(sim.track, 1500);
+    distant.speed = 40;
+    sim.race.step(0.01);
+    sim.ai[0].update(1 / 12, sim.track, sim.cars, sim.race);
+    sim.ai[2].update(1 / 12, sim.track, sim.cars, sim.race);
+    expect(driver.aiTarget).toBeLessThanOrEqual(25);
+    expect(distant.aiTarget).toBeGreaterThan(25);
+    expect(driver.input.ers).toBe(0);
+    const frame = sim.makeFrame();
+    expect(frame[H.FLAG]).toBe(FLAG.YELLOW);
+    expect(frame[carBase(0) + F.LOCAL_FLAG]).toBe(FLAG.YELLOW);
+    expect(frame[carBase(0) + F.CAUTION_SPEED]).toBe(25);
+    expect(frame[carBase(2) + F.LOCAL_FLAG]).toBe(FLAG.GREEN);
+  });
+  it('allows hazard-avoidance paths under yellow but never gains on a moving opponent', () => {
+    const { cars, track } = field();
+    cars[0].place(track, 700);
+    cars[0].speed = 12;
+    cars[1].place(track, 730);
+    cars[1].speed = 0;
+    cars[1].retired = true;
+    cars[2].place(track, 1500);
+    const planner = new TrafficPlanner();
+    const plan = planner.evaluate(cars[0], cars, track, 10, 5, personality(1, 0), true);
+    expect(Math.abs(plan.offset)).toBeGreaterThan(2.5);
+    cars[1].speed = 20;
+    cars[1].retired = false;
+    cars[1].lateral = 6;
+    const following = planner.evaluate(cars[0], cars, track, 15, 5, personality(1, 0), true);
+    expect(following.speedLimit).toBeLessThan(20);
+  });
+  it('labels every flag and rejects invalid configuration/time', () => {
+    expect(Object.values(FLAG).map(flagLabel)).toEqual([
+      'GREEN FLAG',
+      'LOCAL YELLOW',
+      'CHEQUERED',
+      'DOUBLE YELLOW',
+      'BLUE FLAG',
+    ]);
+    expect(() => new MarshalControl(0, 1, () => undefined)).toThrow();
+    const { control, cars, progress } = field();
+    expect(() => control.update(NaN, 10, cars, progress)).toThrow();
+  });
+});
+it('does not erase an earned yellow penalty by entering pits or crossing the finish', () => {
+  const { cars, progress, control, penalties } = field();
+  cars[2].s = 810;
+  cars[2].retired = true;
+  cars[0].s = 700;
+  cars[1].s = 710;
+  control.update(0.01, 10, cars, progress);
+  cars[0].s = 720;
+  control.update(0.01, 10.1, cars, progress);
+  cars[0].inPit = true;
+  control.update(0.01, 12.2, cars, progress);
+  expect(penalties).toHaveLength(1);
+  control.settlePending(cars);
+  expect(penalties).toHaveLength(1);
+});
+it('settles a last-corner infringement before final classification', () => {
+  const { cars, progress, control, penalties } = field();
+  cars[2].s = 810;
+  cars[2].retired = true;
+  cars[0].s = 700;
+  cars[1].s = 710;
+  control.update(0.01, 10, cars, progress);
+  cars[0].s = 720;
+  control.update(0.01, 10.1, cars, progress);
+  control.settlePending(cars);
+  expect(penalties).toEqual([{ car: 0, seconds: 5, code: 'OVERTAKE_UNDER_YELLOW' }]);
+});
