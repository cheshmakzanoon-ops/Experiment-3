+    rearWing: number;
+
+    brakeBias: number;
+
+    diffOnThrottle: number;
+    diffOffThrottle: number;
+
+    frontSpring: number;
+    rearSpring: number;
+
+    frontARB: number;
+    rearARB: number;
+
+    frontRideHeight: number;
+    rearRideHeight: number;
+
+    frontPressure: number;
+    rearPressure: number;
+
+    frontCamber: number;
+    rearCamber: number;
+
+    frontToe: number;
+    rearToe: number;
+}
+
+```
+
+Each field must map into actual simulation parameter.
+
