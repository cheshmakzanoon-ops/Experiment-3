+      car.tires[2].slip = car.tires[3].slip = -1;
+      const before = car.battery; car.step(1 / 240, track);
+      assert(car.regenerationPower > 0);
+      if (assist === 'sport') assert(car.regenerationPower <= VEHICLE.regenPowerW * 0.35 * release * 0.78 + 1e-6);
